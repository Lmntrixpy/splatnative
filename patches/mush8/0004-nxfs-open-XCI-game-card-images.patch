+/// The files of a game package before decryption: an NSP's PFS0 entries, or
+/// the `secure` partition of an XCI game card image (SplatNative).
+pub fn package_files(path: &Path) -> Result<Vec<(String, DynStorage)>> {
+    let f = Arc::new(File::open(path).with_context(|| format!("opening {}", path.display()))?);
+    let size = f.metadata()?.len();
+    let whole: DynStorage = Arc::new(FileRange::new(f, 0, size));
+    if whole.read_vec(0, 4)? == b"PFS0" {
+        let pfs = Pfs0::open(whole)?;
+        return Ok(pfs.entries.iter().map(|e| (e.name.clone(), pfs.storage_of(e))).collect());
+    }
+    let card = xci::Xci::open(whole).with_context(|| format!("{} is neither an NSP nor an XCI", path.display()))?;
+    let secure = card.secure()?;
+    Ok(secure.entries.iter().map(|e| (e.name.clone(), secure.storage_of(e))).collect())
+}
