+/// SplatNative diagnostics: with NX_TRACE_3D_TARGETS, every write into a 3D texture (copies,
+/// CPU texel uploads) is logged (first 64).
+fn trace_3d_write(how: &str, b: &TexBuilder, what: &str) {
+    static ON: LazyLock<bool> = LazyLock::new(|| std::env::var_os("NX_TRACE_3D_TARGETS").is_some());
+    static N: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+    if !*ON {
+        return;
+    }
+    let Some(k) = textures::TexKey::of(b).filter(|k| k.target == 2) else { return };
+    if N.fetch_add(1, Relaxed) < 64 {
+        eprintln!("[frame] 3D write ({how}) into {:#x} {}x{}x{} fmt {} sub {:?}: {what}", k.addr, k.width, k.height, k.depth, k.format, super::objects::view_subresource(b));
+    }
+}
+
+/// SplatNative diagnostics: how many pixels of a float render target hold NaN or Inf (one such
+/// pixel spreads through blurs and tone mapping). Supports RG11B10, RGBA16 and RGBA32 float.
+fn nan_stats(t: &gfx::Texture) -> Option<(usize, usize)> {
+    let fmt = t.pixelFormat();
+    let bpp = match fmt {
+        MTLPixelFormat::RG11B10Float => 4,
+        MTLPixelFormat::RGBA16Float => 8,
+        MTLPixelFormat::RGBA32Float => 16,
+        _ => return None,
+    };
+    let (w, h) = (t.width(), t.height());
+    let g = gfx::gpu();
+    let buf = g.device.0.newBufferWithLength_options(w * h * bpp, MTLResourceOptions::StorageModeShared)?;
+    let cb = g.queue.0.commandBuffer()?;
+    let bl = cb.blitCommandEncoder()?;
+    unsafe {
+        bl.copyFromTexture_sourceSlice_sourceLevel_sourceOrigin_sourceSize_toBuffer_destinationOffset_destinationBytesPerRow_destinationBytesPerImage(
+            t, 0, 0, MTLOrigin { x: 0, y: 0, z: 0 }, MTLSize { width: w, height: h, depth: 1 }, &buf, 0, w * bpp, w * h * bpp,
+        );
+    }
+    bl.endEncoding();
+    cb.commit();
+    cb.waitUntilCompleted();
+    let words = unsafe { std::slice::from_raw_parts(buf.contents().as_ptr() as *const u32, w * h * bpp / 4) };
+    let bad = match bpp {
+        4 => words.iter().filter(|&&x| (x >> 6) & 31 == 31 || (x >> 17) & 31 == 31 || (x >> 27) & 31 == 31).count(),
+        8 => words.chunks(2).filter(|p| p.iter().any(|&x| (x >> 10) & 31 == 31 || (x >> 26) & 31 == 31)).count(),
+        _ => words.chunks(4).filter(|p| p.iter().any(|&x| (x >> 23) & 0xff == 0xff)).count(),
+    };
+    Some((bad, w * h))
+}
