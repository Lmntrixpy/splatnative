+        let flags = (!upper_left) as u32 | ((!ZERO_TO_ONE.load(Relaxed)) as u32) << 1;
+        // The vertex shader's clip-space output feeds the geometry shader unchanged; the flips
+        // happen when the geometry shader emits.
+        let mut vres = self.res(&st, 0, vs.constants, 0);
+        self.vertex_inputs(&mut vres, &st, d);
+        let gres = self.res(&st, 3, gs.constants, flags);
+        let mut fres = self.res(&st, 1, fs.constants, flags);
+        let alpha = st.color_state >> 24 & 0xF;
+        if alpha != 0 && alpha != 8 {
+            fres.flags |= 4;
+            fres.alpha_func = alpha - 1;
+        }
+
+        #[repr(C)]
+        struct GsDraw {
+            mode: u32,
+            first: u32,
+            indexed: u32,
+            base_vertex: i32,
+            verts: u32,
+            pad: [u32; 3],
+        }
+        let (index_buffer, index_offset, indexed) = match d.index {
+            Some((t, addr)) => {
+                if !crate::kernel::aspace().readable(addr, [1u64, 2, 4][t.min(2) as usize] * d.count as u64) {
+                    return Err("index buffer outside guest memory");
+                }
+                let v: Vec<u32> = (0..d.count as u64)
+                    .map(|i| match t {
+                        0 => rd::<u8>(addr + i) as u32,
+                        1 => rd::<u16>(addr + 2 * i) as u32,
+                        _ => rd::<u32>(addr + 4 * i),
+                    })
+                    .collect();
+                let a = self.e.arena.alloc_bytes(unsafe { std::slice::from_raw_parts(v.as_ptr() as *const u8, 4 * v.len()) });
+                if a.new_chunk {
+                    self.use_chunk(&a.buffer);
+                }
+                (a.buffer, a.offset, true)
+            }
+            None => (gfx::gpu().zeros.clone(), 0, false),
+        };
+        let draw = GsDraw { mode: d.mode, first: if indexed { 0 } else { d.first }, indexed: indexed as u32, base_vertex: d.base_vertex, verts, pad: [0; 3] };
+
+        let heap = self.heap;
+        let prev = self.pass.as_ref().unwrap().fixed;
+        let next = {
+            let enc = &self.pass.as_ref().unwrap().enc;
+            if let Some(hb) = heap {
+                for chunk in hb.live() {
+                    enc.useResource_usage_stages(ProtocolObject::from_ref(&*chunk.buffer.0), MTLResourceUsage::Read, MTLRenderStages::Mesh | MTLRenderStages::Fragment);
+                }
+            }
+            enc.useResource_usage_stages(ProtocolObject::from_ref(&*index_buffer.0), MTLResourceUsage::Read, MTLRenderStages::Mesh);
+            bind_fixed(enc, prev, &pipeline, &ds, &st, upper_left, (w, h), [sx, sy, sw, sh])
+        };
+        self.pass.as_mut().unwrap().fixed = Some(next);
+        if super::TRACE_DRAWS.load(Relaxed) {
+            eprintln!("[frame] geometry draw vs {:016x} gs {:016x} fs {:016x} mode {} count {} prims {prims} inst {}", vs.hash, gs.hash, fs.hash, d.mode, d.count, d.instances);
+        }
+        let enc = &self.pass.as_ref().unwrap().enc;
+        unsafe {
+            enc.setMeshBytes_length_atIndex(NonNull::from(&vres).cast(), size_of::<Res>(), 0);
+            enc.setMeshBytes_length_atIndex(NonNull::from(&gres).cast(), size_of::<Res>(), 1);
+            enc.setMeshBytes_length_atIndex(NonNull::from(&draw).cast(), size_of::<GsDraw>(), 2);
+            enc.setMeshBuffer_offset_atIndex(Some(&index_buffer.0), index_offset, 3);
+            enc.setFragmentBytes_length_atIndex(NonNull::from(&fres).cast(), size_of::<Res>(), 0);
+            for (b, tex, slot, sampler) in &vertex_tex {
+                enc.setMeshTexture_atIndex(Some(&tex.0), *b as usize);
+                enc.setMeshSamplerState_atIndex(Some(&sampler.0), *slot as usize);
+            }
+            for (b, tex, slot, sampler) in &frag_tex {
+                enc.setFragmentTexture_atIndex(Some(&tex.0), *b as usize);
+                enc.setFragmentSamplerState_atIndex(Some(&sampler.0), *slot as usize);
+            }
+            if super::occlusion::enabled() {
+                let serial = self.pass.as_ref().unwrap().serial;
+                match self.e.occ.slot(serial) {
+                    Some(off) => enc.setVisibilityResultMode_offset(MTLVisibilityResultMode::Counting, off),
+                    None => enc.setVisibilityResultMode_offset(MTLVisibilityResultMode::Disabled, 0),
+                }
+            }
+        }
+        let one = MTLSize { width: 1, height: 1, depth: 1 };
+        enc.drawMeshThreadgroups_threadsPerObjectThreadgroup_threadsPerMeshThreadgroup(MTLSize { width: prims as usize, height: d.instances as usize, depth: 1 }, one, one);
+        Ok(())
+    }
