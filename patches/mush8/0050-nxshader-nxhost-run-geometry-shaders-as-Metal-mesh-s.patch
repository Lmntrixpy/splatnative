+    /// SplatNative: a draw with a geometry shader. Metal has no geometry stage, so the vertex and
+    /// geometry shaders run together as a mesh shader (nxshader::translate_geometry): one
+    /// single-thread threadgroup per input primitive and instance runs the vertex shader for the
+    /// primitive's vertices, then the geometry code, and emits its triangle strip.
+    #[allow(clippy::too_many_arguments)]
+    fn draw_geometry(
+        &mut self,
+        d: &super::Draw,
+        vs: &super::shaders::Stage,
+        gs: &super::shaders::Stage,
+        fs: &super::shaders::Stage,
+        fsc: &std::sync::Arc<super::shaders::Compiled>,
+        uints: u32,
+        sints: u32,
+        targets: &super::state::Targets,
+    ) -> Result<(), &'static str> {
+        let r = self.draw_geometry_inner(d, vs, gs, fs, fsc, uints, sints, targets);
+        if let Err(e) = r {
+            static SEEN: std::sync::Mutex<Vec<(u64, &'static str)>> = std::sync::Mutex::new(Vec::new());
+            let mut seen = SEEN.lock().unwrap();
+            if !seen.contains(&(gs.hash, e)) {
+                seen.push((gs.hash, e));
+                eprintln!("[gfx] geometry draw {:016x} (mode {} count {}) skipped: {e}", gs.hash, d.mode, d.count);
+            }
+        }
+        r
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    fn draw_geometry_inner(
+        &mut self,
+        d: &super::Draw,
+        vs: &super::shaders::Stage,
+        gs: &super::shaders::Stage,
+        fs: &super::shaders::Stage,
