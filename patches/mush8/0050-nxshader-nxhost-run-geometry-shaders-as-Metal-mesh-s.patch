+    /// SplatNative: the mesh-shader library for a vertex + geometry shader pair whose output
+    /// feeds a fragment shader reading `fs_attributes`. Compiled on the render thread the first
+    /// time (geometry shaders are rare); failures are remembered.
+    pub fn geometry(&mut self, vs: &Stage, gs: &Stage, fs_attributes: u32) -> Option<Arc<Compiled>> {
+        let key = (vs.hash, gs.hash, fs_attributes);
+        if let Some(c) = self.geo.get(&key) {
+            return c.clone();
+        }
+        let t0 = std::time::Instant::now();
+        let c = crate::kernel::blocking(|| compile_geometry(vs, gs, fs_attributes));
+        eprintln!(
+            "[shader] geometry {:016x}+{:016x}: {} in {} ms",
