+        uints: u32,
+        sints: u32,
+        targets: &super::state::Targets,
+    ) -> Result<(), &'static str> {
+        let (verts, prims) = match d.mode {
+            0 => (1, d.count),
+            1 => (2, d.count / 2),
+            3 => (2, d.count.saturating_sub(1)),
+            4 => (3, d.count / 3),
+            5 | 6 => (3, d.count.saturating_sub(2)),
+            _ => return Err("geometry shader with an unsupported input primitive"),
+        };
+        if prims == 0 {
+            return Ok(());
+        }
+        d.validate_indices()?;
+        let st = self.e.st;
+        let gsc = self.e.shaders.geometry(vs, gs, fsc.iface.attributes).ok_or("geometry shader failed")?;
+        let pipeline = self.e.states.mesh_pipeline(&gsc, (vs.hash, gs.hash), fsc, fs.hash ^ (uints as u64) << 48 ^ (sints as u64) << 56, targets, &st)?;
+        let ds = self.e.states.depth_stencil(&st, targets.depth.is_some(), targets.stencil);
+        let (w, h) = self.pass.as_ref().unwrap().size;
+        let (sx, sy, sw, sh) = match st.scissor {
+            Some([x, y, sw, sh]) => {
+                let (x0, y0) = (x.max(0) as u32, y.max(0) as u32);
+                let x1 = ((x as i64 + sw as i64).clamp(0, w as i64)) as u32;
+                let y1 = ((y as i64 + sh as i64).clamp(0, h as i64)) as u32;
+                if x1 <= x0 || y1 <= y0 {
+                    return Ok(());
+                }
+                (x0, y0, x1 - x0, y1 - y0)
+            }
+            None => (0, 0, w, h),
+        };
+        if st.polygon & 3 == 3 {
+            return Ok(());
+        }
+        let upper_left = UPPER_LEFT.load(Relaxed);
+        self.heap = gfx::heap();
+        let vertex_tex = self.stage_textures(&st, 0, &gsc);
+        let frag_tex = self.stage_textures(&st, 1, fsc);
