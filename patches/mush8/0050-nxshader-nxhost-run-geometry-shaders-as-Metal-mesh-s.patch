+// SplatNative: shgeo VS.bin GS.bin [fs-attribute-mask-hex] [out.metal]
+// Translates a vertex + geometry shader pair into the mesh-shader library the host builds.
+fn main() {
+    let args: Vec<String> = std::env::args().skip(1).collect();
+    let vs = std::fs::read(&args[0]).expect("read vertex shader");
+    let gs = std::fs::read(&args[1]).expect("read geometry shader");
+    let fs_attrs = args.get(2).map_or(0, |a| u32::from_str_radix(a, 16).expect("hex mask"));
+    match nxshader::translate_geometry(&vs, &gs, fs_attrs) {
+        Ok(t) => {
+            match args.get(3) {
+                Some(o) => std::fs::write(o, &t.msl).unwrap(),
+                None => print!("{}", t.msl),
+            }
+            eprintln!("{} interface {:?}", t.entry, t.interface);
+        }
+        Err(e) => {
+            eprintln!("error: {e:#}");
+            std::process::exit(1);
+        }
+    }
+}
