+/// SplatNative: copies a whole mip level of `src` into guest memory at `dst` with `stride` bytes
+/// per row (0: tightly packed), as a linear NVN texture lays it out.
+pub fn copy_rows_to_guest(cb: &gfx::CommandBuffer, src: &Texture, (layer, level): (u32, u32), nvn_format: u32, dst: u64, stride: usize) -> Result<(), &'static str> {
+    let (bw, bh, bpb) = super::super::format_info(nvn_format);
+    let (w, h) = level_size(src, level);
+    let packed = w.div_ceil(bw as usize) * bpb as usize;
+    let row = if stride >= packed { stride } else { packed };
+    let rows = h.div_ceil(bh as usize);
+    let len = (row * (rows - 1) + packed) as u64;
+    let heap = gfx::heap().ok_or("no GPU heap")?;
+    let (chunk, off) = heap.buffer_range(dst, len).ok_or("render target outside one GPU heap chunk")?;
+    if off % bpb as usize != 0 {
+        return Err("unaligned render target");
+    }
+    let Some(enc) = cb.blitCommandEncoder() else { return Err("no blit encoder") };
+    let slice = if layered(src) { layer as usize } else { 0 };
+    unsafe {
+        enc.copyFromTexture_sourceSlice_sourceLevel_sourceOrigin_sourceSize_toBuffer_destinationOffset_destinationBytesPerRow_destinationBytesPerImage(
+            src,
+            slice,
+            level as usize,
+            MTLOrigin { x: 0, y: 0, z: 0 },
+            MTLSize { width: w, height: h, depth: 1 },
+            &chunk.buffer.0,
+            off,
+            row,
+            row * rows,
+        )
+    };
+    enc.endEncoding();
+    Ok(())
+}
