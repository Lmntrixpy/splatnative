@@ -429,9 +431,49 @@ impl Replay<'_> {
         eprintln!("[frame] draw dump {n:04}");
     }
 
+    /// SplatNative: render targets are Metal textures, separate from guest memory. A game that
+    /// renders into a linear texture in a CPU-readable pool (NVN texture flag LINEAR 0x10 or
+    /// LINEAR_RENDER_TARGET 0x40, pool flag CPU_UNCACHED 2 / CPU_CACHED 4) reads the result from
+    /// that memory after waiting on a fence; Splatoon 3 does this with 1x1..128x1 targets. Copy
+    /// such targets back into guest memory at their row pitch; the blit is in the same command
+    /// buffer, so it is done when the game's fence wait returns. NX_CPU_TARGET_WRITEBACK=0 turns
+    /// it off.
+    fn write_back_cpu_targets(&mut self) {
+        static ON: LazyLock<bool> = LazyLock::new(|| std::env::var("NX_CPU_TARGET_WRITEBACK").as_deref() != Ok("0"));
+        if !*ON {
+            return;
+        }
+        let u32_at = |b: &TexBuilder, o: usize| u32::from_le_bytes(b[o..o + 4].try_into().unwrap());
+        for b in self.e.colors.clone().into_iter().flatten() {
+            if u32_at(&b, 0x18) & 0x50 == 0 {
+                continue;
+            }
+            let pool = u64::from_le_bytes(b[8..16].try_into().unwrap());
+            let (key, readable) = {
+                let s = STATE.lock().unwrap();
+                (textures::TexKey::of_in(&b, &s), s.pools.get(&pool).is_some_and(|p| p.flags & 6 != 0 && p.cpu != 0))
+            };
+            let Some(key) = key.filter(|k| readable && k.addr >> 63 == 0) else { continue };
+            if textures::is_compressed(key.format) || gfx::has_stencil(key.format) {
+                continue;
+            }
+            let Some((_, tex)) = self.e.textures.cached(&key) else { continue };
+            let sub = super::objects::view_subresource(&b);
+            let stride = u32_at(&b, 0x5c) as usize;
+            let r = copy::copy_rows_to_guest(&self.cb, &tex.0, sub, key.format, key.addr, stride);
+            if TRACE_CPU_WRITEBACK.load(Relaxed) {
+                static N: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+                if N.fetch_add(1, Relaxed) < 200 {
+                    eprintln!("[cpu-target] write back {:#x} {}x{} fmt {} stride {stride}: {r:?}", key.addr, key.width, key.height, key.format);
+                }
+            }
+        }
+    }
+
