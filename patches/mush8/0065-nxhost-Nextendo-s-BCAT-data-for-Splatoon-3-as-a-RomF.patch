+// SplatNative - nexbcat.rs
+// Nextendo's BCAT data for Splatoon 3, delivered the way Prelude-Nextendo does on a console.
+//
+// Splatoon 3 reads its BCAT delivery (summary.yml and the encrypted *.pack.zs.enc of each
+// region directory) and stays "offline" for the Lobby and the shops when there is none
+// ("BcatSummaryNotFound"). Prelude downloads https://nextendo.network/api/bcat/<title id>, a zip
+// with ap-/eu-/jp-/us-default directories, and installs it as a RomFS override under
+// DebugUnderPilot/bcat, which the game reads instead of the system delivery cache. Here the
+// zip is unpacked into work/nextendo-bcat/romfs/DebugUnderPilot/bcat and layered over the RomFS
+// like a mod. The last good copy is kept when the download fails.
+use std::path::{Path, PathBuf};
+
+const SPLATOON3: u64 = 0x0100_C250_0FC2_0000;
+const DIR: &str = "work/nextendo-bcat";
+const SUBDIR: &str = "romfs/DebugUnderPilot/bcat";
+
+/// The mod folder to layer over the RomFS, if this is Splatoon 3 in Nextendo mode and BCAT
+/// data is available (fresh or from an earlier start).
+pub fn bcat_mod() -> Option<PathBuf> {
+    if !super::nextendo::enabled() || crate::game::current().title_id != SPLATOON3 {
+        return None;
+    }
+    let dir = PathBuf::from(DIR);
+    match refresh(&dir) {
+        Ok(n) => eprintln!("[bcat] Nextendo BCAT data for Splatoon 3: {n} files"),
+        Err(e) if dir.join(SUBDIR).is_dir() => eprintln!("[bcat] Nextendo BCAT download failed ({e}), using the copy from an earlier start"),
+        Err(e) => {
+            eprintln!("[bcat] Nextendo BCAT download failed ({e}): the Lobby and shops will stay offline");
+            return None;
+        }
+    }
+    dir.join(SUBDIR).is_dir().then_some(dir)
+}
+
+/// The unpacked region directories (eu-default, ...) for the BCAT delivery cache, if present.
+pub fn bcat_root() -> Option<PathBuf> {
+    if !super::nextendo::enabled() || crate::game::current().title_id != SPLATOON3 {
+        return None;
+    }
+    Some(PathBuf::from(DIR).join(SUBDIR)).filter(|p| p.is_dir())
+}
+
+fn refresh(dir: &Path) -> Result<usize, String> {
+    let path = format!("/api/bcat/{SPLATOON3:016x}");
+    let (status, zip) = super::nexweb::get(&path)?;
+    match status {
+        200 => {}
+        204 => return Err("Nextendo has no schedule published (204)".into()),
+        s => return Err(format!("HTTP {s}")),
+    }
+    let entries = read_zip(&zip)?;
+    let tmp = dir.with_extension("tmp");
+    let _ = std::fs::remove_dir_all(&tmp);
+    let base = tmp.join(SUBDIR);
+    let mut n = 0;
+    for (name, data) in entries {
+        if name.ends_with('/') {
+            continue;
+        }
+        let rel = Path::new(&name);
+        if rel.is_absolute() || rel.components().any(|c| !matches!(c, std::path::Component::Normal(_))) {
+            return Err(format!("unsafe path in the zip: {name}"));
+        }
+        let out = base.join(rel);
+        if let Some(p) = out.parent() {
+            std::fs::create_dir_all(p).map_err(|e| e.to_string())?;
+        }
+        std::fs::write(&out, data).map_err(|e| e.to_string())?;
+        n += 1;
+    }
+    if n == 0 {
+        return Err("the zip is empty".into());
+    }
+    let _ = std::fs::remove_dir_all(dir);
+    std::fs::rename(&tmp, dir).map_err(|e| e.to_string())?;
+    Ok(n)
+}
+
+fn u16_at(b: &[u8], o: usize) -> Option<usize> {
+    b.get(o..o + 2).map(|x| u16::from_le_bytes([x[0], x[1]]) as usize)
+}
+
+fn u32_at(b: &[u8], o: usize) -> Option<usize> {
+    b.get(o..o + 4).map(|x| u32::from_le_bytes(x.try_into().unwrap()) as usize)
+}
+
+/// Stored (uncompressed) zip entries, read through the central directory.
+fn read_zip(b: &[u8]) -> Result<Vec<(String, &[u8])>, String> {
+    let low = b.len().saturating_sub(22 + 0xffff);
+    let eocd = (low..b.len().saturating_sub(21)).rev().find(|&i| u32_at(b, i) == Some(0x0605_4b50)).ok_or("not a zip")?;
+    let count = u16_at(b, eocd + 10).ok_or("short zip")?;
+    let mut p = u32_at(b, eocd + 16).ok_or("short zip")?;
+    let mut out = Vec::new();
+    for _ in 0..count {
+        if u32_at(b, p) != Some(0x0201_4b50) {
+            return Err("bad central directory".into());
+        }
+        let method = u16_at(b, p + 10).ok_or("short zip")?;
+        let size = u32_at(b, p + 20).ok_or("short zip")?;
+        let (nlen, xlen, clen) = (u16_at(b, p + 28).ok_or("short zip")?, u16_at(b, p + 30).ok_or("short zip")?, u16_at(b, p + 32).ok_or("short zip")?);
+        let local = u32_at(b, p + 42).ok_or("short zip")?;
+        let name = String::from_utf8_lossy(b.get(p + 46..p + 46 + nlen).ok_or("short zip")?).into_owned();
+        p += 46 + nlen + xlen + clen;
+        if u32_at(b, local) != Some(0x0403_4b50) {
+            return Err(format!("bad local header for {name}"));
+        }
+        let start = local + 30 + u16_at(b, local + 26).ok_or("short zip")? + u16_at(b, local + 28).ok_or("short zip")?;
+        if method != 0 {
+            return Err(format!("{name} is compressed (method {method}), only stored entries are supported"));
+        }
+        out.push((name, b.get(start..start + size).ok_or("short zip")?));
+    }
+    Ok(out)
+}
+
