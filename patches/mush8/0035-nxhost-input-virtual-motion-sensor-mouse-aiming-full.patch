+/// SplatNative: mouse aiming. While the mouse is captured (M in the game window, Esc releases),
+/// the window layer adds the mouse movement in points here and reports its buttons as Switch
+/// buttons; both are read by the keyboard player.
+pub static MOUSE_AIM: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+pub static MOUSE_BUTTONS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+static MOUSE_DELTA: std::sync::Mutex<(f64, f64)> = std::sync::Mutex::new((0.0, 0.0));
+
+pub fn mouse_moved(dx: f64, dy: f64) {
+    let mut d = MOUSE_DELTA.lock().unwrap();
+    d.0 += dx;
+    d.1 += dy;
+}
+
+fn take_mouse_delta() -> (f32, f32) {
+    let d = std::mem::take(&mut *MOUSE_DELTA.lock().unwrap());
+    (d.0 as f32, d.1 as f32)
+}
+
+fn env_f32(k: &str, default: f32) -> f32 {
+    std::env::var(k).ok().and_then(|v| v.parse().ok()).unwrap_or(default)
+}
+
+/// SplatNative: the keyboard player's emulated motion sensor, so games that aim with the gyro
+/// (Splatoon 3 does by default) can be played without a motion controller. Mouse movement
+/// (radians per point: NX_MOUSE_SENS) and I/K (radians per second: NX_KEY_GYRO_RATE) turn a
+/// virtual controller; the rotation is spread over a few milliseconds so a game that reads one
+/// sample per frame still sees all of it. NX_KEY_GYRO=0 turns it off.
+pub struct VirtualGyro {
+    pending: [f32; 2],
+    pitch: f32,
+    last: Option<std::time::Instant>,
+}
+
+const GYRO_SPREAD: f32 = 0.012;
+const MAX_PITCH: f32 = 1.4;
+
+impl VirtualGyro {
+    const fn new() -> Self {
+        VirtualGyro { pending: [0.0; 2], pitch: 0.0, last: None }
+    }
+
+    pub fn enabled() -> bool {
+        static ON: std::sync::LazyLock<bool> = std::sync::LazyLock::new(|| std::env::var("NX_KEY_GYRO").as_deref() != Ok("0"));
+        *ON
+    }
+
+    /// One sample: `turn` is (yaw, pitch) in radians added since the last call, `tilt` (yaw,
+    /// pitch) axes (-1..1) turning at `rate` radians per second. Positive yaw turns right,
+    /// positive pitch aims up.
+    pub fn sample(&mut self, turn: (f32, f32), tilt: (f32, f32), rate: f32, now: std::time::Instant) -> Motion {
+        let dt = self.last.replace(now).map_or(0.0, |t| now.duration_since(t).as_secs_f32()).min(0.1);
+        self.pending[0] += turn.0 + tilt.0 * rate * dt;
+        self.pending[1] += turn.1 + tilt.1 * rate * dt;
+        let mut gyro = [0.0; 3];
+        if dt > 0.0 {
+            let share = 1.0 - (-dt / GYRO_SPREAD).exp();
+            let yaw = self.pending[0] * share;
+            let pitch = (self.pitch + self.pending[1] * share).clamp(-MAX_PITCH, MAX_PITCH) - self.pitch;
+            self.pending[0] -= yaw;
+            self.pending[1] -= self.pending[1] * share;
+            if (self.pitch + pitch).abs() >= MAX_PITCH {
+                self.pending[1] = 0.0;
+            }
+            self.pitch += pitch;
+            // Switch sixaxis axes (controller lying flat): Splatoon 3 aims down for a rotation
+            // about +x and turns left for one about +z (checked in game, docs/STEUERUNG.md).
+            gyro = [-pitch / dt, 0.0, -yaw / dt];
+        }
+        // Gravity seen by the tilted controller, consistent with integrating the gyro above.
+        let (s, c) = self.pitch.sin_cos();
+        Motion { accel: [0.0, -s, -c], gyro }
+    }
+}
