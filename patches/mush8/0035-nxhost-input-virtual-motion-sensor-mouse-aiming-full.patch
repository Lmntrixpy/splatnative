+/// SplatNative: captures (hides and pins) the cursor for mouse aiming, or releases it. While
+/// captured, mouse movement turns the keyboard player's virtual motion sensor and the buttons
+/// are ZR (left), R (right) and the right stick click (middle); see input::VirtualGyro.
+#[cfg(target_os = "macos")]
+fn set_mouse_aim(window: &NSWindow, on: bool) {
+    use std::sync::atomic::Ordering::Relaxed;
+    if crate::input::MOUSE_AIM.swap(on, Relaxed) == on {
+        return;
+    }
+    crate::input::MOUSE_BUTTONS.store(0, Relaxed);
+    if on {
+        let f = window.frame();
+        let top = objc2_app_kit::NSScreen::screens(window.mtm()).firstObject().map_or(f.origin.y + f.size.height, |s| s.frame().size.height);
+        let center = objc2_core_foundation::CGPoint { x: f.origin.x + f.size.width / 2.0, y: top - (f.origin.y + f.size.height / 2.0) };
+        objc2_core_graphics::CGWarpMouseCursorPosition(center);
+        objc2_app_kit::NSCursor::hide();
+    } else {
+        objc2_app_kit::NSCursor::unhide();
+    }
+    objc2_core_graphics::CGAssociateMouseAndMouseCursorPosition(!on);
+    eprintln!("[input] mouse aiming {}", if on { "on (M or Esc releases)" } else { "off" });
+}
+
+/// Mouse events while aiming: returns true when the event was used for aiming.
+#[cfg(target_os = "macos")]
+fn mouse_aim(ev: &objc2_app_kit::NSEvent) -> bool {
+    use objc2_app_kit::NSEventType as T;
+    use std::sync::atomic::Ordering::Relaxed;
+    if !crate::input::MOUSE_AIM.load(Relaxed) {
+        return false;
+    }
+    let bit = |ev: &objc2_app_kit::NSEvent| match ev.r#type() {
+        T::LeftMouseDown | T::LeftMouseUp => crate::input::ZR,
+        T::RightMouseDown | T::RightMouseUp => crate::input::R,
+        _ if ev.buttonNumber() == 2 => crate::input::STICK_R,
+        _ => 0,
+    };
+    match ev.r#type() {
+        T::MouseMoved | T::LeftMouseDragged | T::RightMouseDragged | T::OtherMouseDragged => crate::input::mouse_moved(ev.deltaX(), ev.deltaY()),
+        T::LeftMouseDown | T::RightMouseDown | T::OtherMouseDown => _ = crate::input::MOUSE_BUTTONS.fetch_or(bit(ev), Relaxed),
+        T::LeftMouseUp | T::RightMouseUp | T::OtherMouseUp => _ = crate::input::MOUSE_BUTTONS.fetch_and(!bit(ev), Relaxed),
+        _ => {}
+    }
+    true
+}
