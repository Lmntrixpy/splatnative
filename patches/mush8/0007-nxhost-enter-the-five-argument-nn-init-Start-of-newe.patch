From 6062c4a051c4ee1e1af5ade6ab15582a3862712a Mon Sep 17 00:00:00 2001
From: schoeremy <jeremyfroeb2007@gmail.com>
Date: Mon, 23 Nov 2026 00:17:29 +0100
Subject: [PATCH 07/44] nxhost: enter the five-argument nn::init::Start of
 newer SDKs

Splatoon 3's sdk exports nn::init::Start(u64, u64, void(*)(), void(*)(),
void(*)()) instead of MK8DX's four-argument form. Its disassembly calls the
third and fourth arguments where the old form calls init_done and
init_modules, and the fifth only after the game's main returns (fini).
Guest entry now loads x4 too; the host passes a no-op fini callback.
MK8DX's four-argument entry is found and called as before.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013yetZ2nJDh2A6QWpF2QWuu
---
 crates/nxhost/src/guest.rs  |  4 +++-
 crates/nxhost/src/kernel.rs |  2 +-
 crates/nxhost/src/main.rs   | 16 ++++++++++++++--
 crates/nxhost/src/svc.rs    |  2 +-
 4 files changed, 19 insertions(+), 5 deletions(-)

diff --git a/crates/nxhost/src/guest.rs b/crates/nxhost/src/guest.rs
index fb3fbe4..71aadb8 100644
--- a/crates/nxhost/src/guest.rs
+++ b/crates/nxhost/src/guest.rs
@@ -82,7 +82,8 @@ const _: () = assert!(std::mem::size_of::<Frame>() == 0x320);
 pub struct Entry {
     pub pc: u64,
     pub sp: u64,
-    pub x: [u64; 4],
+    /// x0..x4 at entry. x4 is the fini callback of newer SDKs' nn::init::Start.
+    pub x: [u64; 5],
 }
 
 #[allow(improper_ctypes)]
@@ -111,6 +112,7 @@ global_asm!(
     "ldp x9, x10, [x0]",
     "mov sp, x10",
     "ldp x2, x3, [x0, #0x20]",
+    "ldr x4, [x0, #0x30]",
     "ldp x0, x1, [x0, #0x10]",
     "adr x30, 1f",
     "br x9",
diff --git a/crates/nxhost/src/kernel.rs b/crates/nxhost/src/kernel.rs
