--- a/crates/nxhost/src/svc.rs
+++ b/crates/nxhost/src/svc.rs
@@ -95,7 +95,7 @@ fn dispatch_inner(f: &mut Frame) {
         },
         0x09 => match kernel::thread(x[0] as u32) {
