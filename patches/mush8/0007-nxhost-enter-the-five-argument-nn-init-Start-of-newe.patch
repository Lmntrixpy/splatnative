--- a/crates/nxhost/src/kernel.rs
+++ b/crates/nxhost/src/kernel.rs
@@ -479,7 +479,7 @@ pub fn thread(h: u32) -> Option<Arc<Thread>> {
     }
 }
 
-pub fn start_thread(t: Arc<Thread>, args: [u64; 4]) -> std::io::Result<std::thread::JoinHandle<()>> {
+pub fn start_thread(t: Arc<Thread>, args: [u64; 5]) -> std::io::Result<std::thread::JoinHandle<()>> {
     t.started.store(true, Relaxed);
     {
         let mut g = KERNEL.lock();
diff --git a/crates/nxhost/src/main.rs b/crates/nxhost/src/main.rs
index dd84587..5010fc2 100644
--- a/crates/nxhost/src/main.rs
+++ b/crates/nxhost/src/main.rs
@@ -36,6 +36,15 @@ static INITS: OnceLock<Vec<u64>> = OnceLock::new();
 
 extern "C" fn init_done() {}
 
+/// Passed as the fifth argument of the newer nn::init::Start (Splatoon 3's SDK), which
+/// calls it after nnMain returns; the host exits when the main thread returns anyway.
+extern "C" fn fini_done() {}
+
+/// nn::init::Start as exported by the SDK: (handle, main base, init_done, init_modules)
+/// in MK8DX's SDK, plus a trailing fini callback in newer ones.
+const INIT_START_4: &str = "_ZN2nn4init5StartEmmPFvvES2_";
+const INIT_START_5: &str = "_ZN2nn4init5StartEmmPFvvES2_S2_";
+
 extern "C" fn init_modules() {
     for &f in INITS.get().unwrap() {
         let f: extern "C" fn() = unsafe { std::mem::transmute(f as usize) };
@@ -390,7 +399,7 @@ fn start(args: Args) -> Result<()> {
     );
     diag::start_watch(&mods.iter().map(|m| (m.name.clone(), m.base)).collect::<Vec<_>>());
     let _ = INITS.set(mods.iter().filter_map(|m| m.dynamic.init.map(|i| m.base + i)).collect());
-    let start = loader::symbol(&mods, "_ZN2nn4init5StartEmmPFvvES2_").context("nn::init::Start not found")?;
+    let start = loader::symbol(&mods, INIT_START_4).or_else(|| loader::symbol(&mods, INIT_START_5)).context("nn::init::Start not found")?;
     let sdk = mods.iter().find(|m| m.name == "sdk").context("no sdk module")?;
     nvn::init(sdk.base, &sdk.module_id)?;
     if std::env::var_os("NX_PREWARM").is_some() {
@@ -409,7 +418,10 @@ fn start(args: Args) -> Result<()> {
     services::nexweb::start();
     eprintln!("[host] main thread {h:#x}: prio {} core {} stack {stack_size:#x}; entering nn::init::Start", npdm.priority, npdm.core);
     let main_base = mods[0].base;
-    let j = kernel::start_thread(t, [h as u64, main_base, init_done as *const () as usize as u64, init_modules as *const () as usize as u64])?;
+    let j = kernel::start_thread(
+        t,
+        [h as u64, main_base, init_done as *const () as usize as u64, init_modules as *const () as usize as u64, fini_done as *const () as usize as u64],
+    )?;
     std::thread::spawn(move || {
         j.join().ok();
         eprintln!("[host] main thread returned");
diff --git a/crates/nxhost/src/svc.rs b/crates/nxhost/src/svc.rs
