+        words[0] = 0x9000_0011; // adrp x17, #0
+        words[1] = 0x9104_0231; // add x17, x17, #0x100
+        words[2] = 0x7100_15FF; // cmp w15, #5
+        words[3] = 0x5400_0228; // b.hi
+        words[4] = ADR_X18(16, 32); // adr x18, #32 (anchor 0x20)
+        words[5] = 0x386F_6A20; // ldrb w0, [x17, x15]
+        words[6] = 0x8B00_0A52; // add x18, x18, x0, lsl #2
+        words[7] = 0xD61F_0240; // br x18
+        let mut image: Vec<u8> = words.iter().flat_map(|w| w.to_le_bytes()).collect();
+        image.resize(0x200, 0);
+        image[table as usize..table as usize + 6].copy_from_slice(&[0, 1, 2, 5, 1, 3]);
+        let need = vec![Need::Plain; words.len()];
+        let sw = detect(&words, &image, &need, 7).unwrap();
+        assert_eq!(sw.anchor, 0x20);
+        assert_eq!(sw.width, 1);
+        assert!(sw.decoded);
+        assert_eq!(sw.pads, 256);
+        assert_eq!(sw.samples, vec![0x20, 0x24, 0x28, 0x2c, 0x34]);
+    }
+
+    #[test]
+    fn rejects_unknown_shapes() {
+        let mut words = vec![0xD503_201Fu32; 8];
+        words[7] = 0xD61F_0240;
+        let need = vec![Need::Plain; 8];
+        assert!(detect(&words, &[0; 32], &need, 7).is_err());
+    }
+
+    #[test]
+    fn ldrh_without_table_uses_full_range() {
+        let mut words = vec![0xD503_201Fu32; 8];
+        words[3] = ADR_X18(12, 16);
+        words[4] = 0x786D_7B03; // ldrh w3, [x24, x13, lsl #1]  (x24 set elsewhere)
+        words[5] = 0x8B03_0A52; // add x18, x18, x3, lsl #2
+        words[6] = 0xD61F_0240;
+        let need = vec![Need::Plain; 8];
+        let sw = detect(&words, &[0; 32], &need, 6).unwrap();
+        assert_eq!((sw.width, sw.pads, sw.decoded), (2, 65536, false));
+    }
+}
