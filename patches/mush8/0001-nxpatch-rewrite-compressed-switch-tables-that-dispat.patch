+// SplatNative - switch.rs
+// Compiler-generated compressed switch tables that dispatch through x18.
+//
+// Mush8 rewrites every x18 access, so a `br x18` cannot simply jump: the
+// trampoline has to reach the target without clobbering any guest register or
+// the flags. Mush8 does that for a hardcoded list of i32 tables. Splatoon 3
+// has 110 such sites, all of clang's compressed form:
+//
+//     adr   x18, anchor
+//     ldrb  wK, [xB, xI]            (or ldrh wK, [xB, xI, lsl #1])
+//     add   x18, x18, xK, lsl #2
+//     br    x18
+//
+// The target is always anchor + 4*e with e an 8- or 16-bit table entry. The
+// trampoline computes e from the runtime x18 and jumps through a pad table
+// (one `ldp; b` pair per possible e), so dispatch is O(1), uses no flags and
+// restores the two scratch registers before reaching the target. A value
+// outside the pad range traps (`brk #0x18`) instead of jumping somewhere wrong.
+//
+// For ldrb the pad range is the full 256 entries and needs no table decoding.
+// For ldrh the table is decoded when its base (adrp+add) and bound (cmp+b.hi)
+// can be found; otherwise the full 65536-entry range is used. Decoding only
+// narrows the pad range: dispatch always uses the runtime value.
+use crate::asm::{self, Reg, SP};
+use crate::rewrite::{Emitter, Need, ctx};
+use anyhow::{Context, Result, bail, ensure};
+use std::collections::BTreeSet;
+
+const WINDOW: usize = 24;
+const BASE_SEARCH: usize = 4096;
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Switch {
+    pub site: u64,
+    pub anchor: u64,
+    /// 1 for ldrb, 2 for ldrh tables.
+    pub width: u8,
+    /// Number of entries the pad table covers (anchor + 4*e for e < pads).
+    pub pads: u64,
+    /// Whether the table itself was decoded.
+    pub decoded: bool,
+    /// Real targets (decoded) or representative ones, for `nxpatch verify`.
+    pub samples: Vec<u64>,
+}
+
+fn add_x18_lsl2(w: u32) -> Option<Reg> {
+    (w & 0xFFE0_FFFF == 0x8B00_0A52).then_some((w >> 16) & 31)
+}
+
+struct Load {
+    width: u8,
+    rt: Reg,
+    rn: Reg,
+    rm: Reg,
+}
+
+/// `ldrb wT, [xN, xM]` / `ldrb wT, [xN, wM, uxtw]` / `ldrh wT, [xN, xM, lsl #1]`.
+fn table_load(w: u32) -> Option<Load> {
+    let width = match w & 0xFFE0_0C00 {
+        0x3860_0800 => 1,
+        0x7860_0800 => 2,
+        _ => return None,
+    };
+    let option = (w >> 13) & 7;
+    let scaled = (w >> 12) & 1 == 1;
+    if !(option == 0b011 || option == 0b010) || (width == 2 && !scaled) || (width == 1 && scaled) {
+        return None;
+    }
+    Some(Load { width, rt: w & 31, rn: (w >> 5) & 31, rm: (w >> 16) & 31 })
+}
+
+fn is_adr_to(w: u32, rd: Reg) -> bool {
+    asm::is_adr(w) && w & 31 == rd
+}
+
+/// Conservative: true if `w` may write register `r` (any instruction whose
+/// Rt/Rd or Rt2 field is `r`). False positives only make table decoding give up.
+fn may_write(w: u32, r: Reg) -> bool {
+    let pair = w & 0x3A00_0000 == 0x2800_0000;
+    w & 31 == r || (pair && (w >> 10) & 31 == r)
+}
+
+/// `cmp wN, #imm` (subs wzr, wN, #imm, no shift).
+fn cmp_w_imm(w: u32) -> Option<(Reg, u32)> {
+    (w & 0xFFC0_001F == 0x7100_001F).then(|| ((w >> 5) & 31, (w >> 10) & 0xFFF))
+}
+
+fn bcond(w: u32) -> Option<u32> {
+    asm::is_bcond(w).then_some(w & 0xF)
+}
+
+/// Finds the base of the table read by the load at `l`: the nearest earlier
+/// writer of `b` must be `add xB, xB, #lo`, and the writer before that `adrp xB`.
+fn table_base(words: &[u32], l: usize, b: Reg) -> Option<u64> {
+    let mut m = l;
+    let mut lo = None;
+    for _ in 0..BASE_SEARCH {
+        m = m.checked_sub(1)?;
+        let w = words[m];
+        // Conditional branches leave this path as fallthrough; b/bl/br/ret end it
+        // (bl may also clobber the base register).
+        if asm::is_uncond_branch(w) {
+            return None;
+        }
+        if !may_write(w, b) {
+            continue;
+        }
+        match lo {
+            None if w & 0xFFC0_0000 == 0x9100_0000 && (w >> 5) & 31 == b => lo = Some(((w >> 10) & 0xFFF) as u64),
+            Some(lo) if asm::is_adrp(w) => return Some(asm::adr_target(w, m as u64 * 4) + lo),
+            _ => return None,
+        }
+    }
+    None
+}
+
+/// Number of table entries from `cmp wI, #c; b.hi` (c+1) or `b.hs` (c) shortly before `before`.
+fn table_count(words: &[u32], before: usize, index: Reg) -> Option<u64> {
+    let lo = before.saturating_sub(WINDOW);
+    for m in (lo..before).rev() {
+        if let Some((rn, c)) = cmp_w_imm(words[m]) {
+            if rn != index {
+                return None;
+            }
+            return match words.get(m + 1).copied().and_then(bcond) {
+                Some(0x8) => Some(c as u64 + 1),
+                Some(0x2) => Some(c as u64),
+                _ => None,
+            };
+        }
+    }
+    None
+}
+
+pub fn detect(words: &[u32], image: &[u8], need: &[Need], i: usize) -> Result<Switch> {
+    ensure!(words[i] == 0xD61F_0240, "not br x18");
+    let lo = i.saturating_sub(WINDOW);
+    let (j, k_reg) = (lo..i).rev().find_map(|j| add_x18_lsl2(words[j]).map(|k| (j, k))).context("no `add x18, x18, xK, lsl #2` before it")?;
+    let a = (lo..j).rev().find(|&a| is_adr_to(words[a], 18)).context("no `adr x18, anchor` before it")?;
+    let anchor = asm::adr_target(words[a], a as u64 * 4);
+    for m in (a + 1..i).filter(|&m| m != j) {
+        let (w, pc) = (words[m], m as u64 * 4);
+        // `need` comes from classify (capstone operand analysis), so SIMD v18 is not mistaken for x18.
+        ensure!(need[m] == Need::Plain, "x18 is also used at {pc:#x}");
+        ensure!(!asm::is_uncond_branch(w), "branch at {pc:#x} inside the dispatch sequence");
+    }
+    // xK is consumed by the add, so code between the add and the br may reuse it.
+    let l = (lo..j).rev().find(|&m| may_write(words[m], k_reg)).context("no load of the table entry")?;
+    let load = table_load(words[l]).with_context(|| format!("entry register x{k_reg} is not loaded by ldrb/ldrh at {:#x}", l * 4))?;
+    ensure!(load.rt == k_reg);
+
+    let base = table_base(words, l, load.rn);
+    let count = table_count(words, a.min(l), load.rm);
+    let mut decoded = None;
+    if let (Some(base), Some(count)) = (base, count) {
+        let w = load.width as usize;
+        let at = base as usize;
+        if count > 0 && count <= 0x1_0000 && image.len() >= at + w * count as usize {
+            let e: Vec<u64> = (0..count as usize)
+                .map(|n| if w == 1 { image[at + n] as u64 } else { u16::from_le_bytes([image[at + 2 * n], image[at + 2 * n + 1]]) as u64 })
+                .collect();
+            decoded = Some(e);
+        }
+    }
+    let text_end = words.len() as u64 * 4;
+    let full = 1u64 << (8 * load.width as u64);
+    let (pads, samples, ok) = match &decoded {
+        Some(e) => {
+            let t: BTreeSet<u64> = e.iter().map(|&e| anchor + 4 * e).collect();
+            if t.iter().all(|&t| t < text_end) {
+                let pads = if load.width == 1 { full } else { e.iter().max().unwrap() + 1 };
+                (pads, t.into_iter().collect(), true)
+            } else {
+                (full, Vec::new(), false)
+            }
+        }
+        None => (full, Vec::new(), false),
+    };
+    let samples = if samples.is_empty() { (0..8).map(|e| anchor + 4 * e).filter(|&t| t < text_end).collect() } else { samples };
+    Ok(Switch { site: i as u64 * 4, anchor, width: load.width, pads, decoded: ok, samples })
+}
+
+fn and_imm3(d: Reg, n: Reg) -> u32 {
+    0x9240_0400 | (n << 5) | d
+}
+fn lsr_imm(d: Reg, n: Reg, sh: u32) -> u32 {
+    0xD340_FC00 | (sh << 16) | (n << 5) | d
+}
+fn adr_fwd(d: Reg, bytes: u32) -> u32 {
+    0x1000_0000 | ((bytes & 3) << 29) | ((bytes >> 2) << 5) | d
+}
+fn add_lsl(d: Reg, n: Reg, m: Reg, sh: u32) -> u32 {
+    0x8B00_0000 | (m << 16) | (sh << 10) | (n << 5) | d
+}
+fn br(n: Reg) -> u32 {
+    0xD61F_0000 | (n << 5)
+}
+fn cbnz_x(t: Reg) -> u32 {
+    0xB500_0000 | t
+}
+
+/// Emits the dispatch trampoline. `prologue` leaves the guest's x18 in `s`
+/// and the thread context in `t`, with s/t saved at [sp, #-16].
+pub fn emit(e: &mut Emitter, s: Reg, t: Reg, sw: &Switch, _keypage: u64, text_end: u64, prologue: impl FnOnce(&mut Emitter) -> Result<()>) -> Result<()> {
+    if sw.pads == 0 {
+        bail!("empty switch table");
+    }
+    let range = sw.pads.next_power_of_two();
+    prologue(e)?;
+    e.emit(asm::str(s, t, ctx::X18));
+    let pc = e.pc();
+    e.emit(asm::adrp(t, pc, sw.anchor)?);
+    if sw.anchor & 0xFFF != 0 {
+        e.emit(asm::add_imm(t, t, (sw.anchor & 0xFFF) as u32));
+    }
+    e.emit(asm::sub_reg(s, s, t));
+    let slow = e.label();
+    e.emit(and_imm3(t, s));
+    e.cond_to(cbnz_x(t), slow);
+    e.emit(lsr_imm(t, s, 2 + range.trailing_zeros()));
+    e.cond_to(cbnz_x(t), slow);
+    e.emit(adr_fwd(t, 12));
+    e.emit(add_lsl(t, t, s, 1));
+    e.emit(br(t));
+    for n in 0..range {
+        let target = sw.anchor + 4 * n;
+        if n < sw.pads && target < text_end {
+            e.emit(asm::ldp(s, t, SP, -16));
+            let pc = e.pc();
+            e.emit(asm::b(pc, target)?);
+        } else {
+            e.emit(asm::brk(0x18));
+            e.emit(asm::brk(0x18));
+        }
+    }
+    e.bind(slow);
+    e.emit(asm::brk(0x18));
+    Ok(())
+}
+
