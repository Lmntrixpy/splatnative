From cd2b72ae94d290ea8f81e5f2b6b7b4e331d85ae5 Mon Sep 17 00:00:00 2001
From: schoeremy <jeremyfroeb2007@gmail.com>
Date: Mon, 23 Nov 2026 10:23:58 +0100
Subject: [PATCH 28/62] nxhost diag: NX_TRACE_UBO dumps uniform buffer words of
 traced draws

NX_TRACE_UBO=stage:index:first:count[:vs-hash] prints the words a traced
draw sees in that uniform binding (inline updates included).
---
 crates/nxhost/src/nvn/draw/exec.rs | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/crates/nxhost/src/nvn/draw/exec.rs b/crates/nxhost/src/nvn/draw/exec.rs
index 709b40f..4de3e4d 100644
--- a/crates/nxhost/src/nvn/draw/exec.rs
+++ b/crates/nxhost/src/nvn/draw/exec.rs
@@ -126,6 +126,23 @@ impl Replay<'_> {
                 "[frame] draw rt {rt:?} vs {:016x} fs {:016x} poly {:#x} mode {} count {} inst {} vp {:?} sc {:?} ds {:#x} cs {:#x} mask {:#x} tex {tex:?}",
                 vs.hash, fs.hash, st.polygon, d.mode, d.count, d.instances, st.viewport, st.scissor, st.depth_stencil, st.color_state, st.channel_mask
             );
+            if let Ok(spec) = std::env::var("NX_TRACE_UBO") {
+                // NX_TRACE_UBO=stage:index:first:count[:vs-hash] (32-bit words), e.g. 0:0:16:12
+                let parts: Vec<&str> = spec.split(':').collect();
+                let f: Vec<usize> = parts.iter().take(4).filter_map(|v| v.parse().ok()).collect();
+                let want = parts.get(4).and_then(|h| u64::from_str_radix(h, 16).ok());
+                if let (&[stage, index, first, count], true) = (&f[..], want.is_none_or(|h| h == vs.hash)) {
+                    let (addr, size) = st.ubos.get(stage).and_then(|u| u.get(index)).copied().unwrap_or((0, 0));
+                    let src = match self.e.overlays.range(..=addr).next_back() {
+                        Some((&base, &(osize, _, ptr))) if addr < base + osize => ptr as u64 + (addr - base),
+                        _ => addr,
+                    };
+                    let words: Vec<String> = (first..first + count)
+                        .map(|i| if src == 0 || (4 * i as u64) >= size.max(0x10000) { "-".into() } else { format!("{:.4}", f32::from_bits(unsafe { ((src + 4 * i as u64) as *const u32).read_unaligned() })) })
+                        .collect();
+                    eprintln!("[frame]   ubo {stage}:{index} {addr:#x}+{size:#x} [{first}..] {}", words.join(" "));
+                }
+            }
         }
         if st.polygon & 3 == 3 {
             return Ok(());
-- 
