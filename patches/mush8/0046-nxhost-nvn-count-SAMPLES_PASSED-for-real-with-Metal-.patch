+++ b/crates/nxhost/src/nvn/draw/occlusion.rs
@@ -0,0 +1,157 @@
+// SplatNative: real SAMPLES_PASSED counting with Metal visibility results.
+//
+// NVN's SAMPLES_PASSED counter (ResetCounter / ReportCounter type 1) counts the samples that pass
+// the depth/stencil tests. Mush8 answered every report with "one more than before", which keeps
+// occlusion-culled objects visible, but Splatoon 3 also measures ink with it: its paint checker
+// (`PaintDrawCommandProcessor::QueryBuffer`, `DirectionPaintCheckerMaterial`) resets the counter,
+// draws a probe that only passes where there is ink, and reports. Every probe read as one sample,
+// i.e. almost no ink, so swimming never sped up and inked walls could not be climbed.
+//
+// Here every draw after a reset counts into an 8-byte slot of a shared visibility buffer (one
+// slot per counter interval and render pass, Accumulate mode, zeroed when handed out). A report
+// records the slots since the last reset; once the command buffer has completed (completion
+// handler, or the game's nvnSyncWait), their sum is written to the report together with the
+// timestamp. NX_REAL_OCCLUSION=0 restores the old fake counter.
+
+use crate::gfx::{self, Shared};
+use objc2_metal::*;
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+use std::sync::{LazyLock, Mutex};
+
+const SLOTS: usize = 1 << 16;
+/// More slots than this since one reset: counting stops until the next reset (the report then
+/// falls back to the fake value) instead of collecting slots forever.
+const MAX_INTERVAL_SLOTS: usize = 8192;
+
+pub fn enabled() -> bool {
+    static ON: LazyLock<bool> = LazyLock::new(|| std::env::var("NX_REAL_OCCLUSION").as_deref() != Ok("0") && BUFFER.is_some());
+    *ON
+}
+
+fn trace() -> bool {
+    static ON: LazyLock<bool> = LazyLock::new(|| std::env::var("NX_TRACE_OCCLUSION").is_ok_and(|v| v == "1"));
+    *ON
+}
+
+static BUFFER: LazyLock<Option<Shared<gfx::Buffer>>> =
+    LazyLock::new(|| gfx::gpu().device.0.newBufferWithLength_options(SLOTS * 8, MTLResourceOptions::StorageModeShared).map(Shared));
+
+pub fn buffer() -> Option<&'static gfx::Buffer> {
+    BUFFER.as_ref().filter(|_| enabled()).map(|b| &*b.0)
+}
+
+/// Render passes get a serial so a slot is only ever used inside one encoder.
+static PASS_SERIAL: AtomicU64 = AtomicU64::new(0);
+
+pub fn new_pass() -> u64 {
+    PASS_SERIAL.fetch_add(1, Relaxed) + 1
+}
+
+#[derive(Default)]
+pub struct Counter {
+    next: usize,
+    since_reset: Vec<u32>,
+    open: Option<(u32, u64)>,
+    counting: bool,
+    lossy: bool,
+}
+
+struct Pending {
+    cb: Shared<gfx::CommandBuffer>,
+    addr: u64,
+    slots: Vec<u32>,
+    lossy: bool,
+    fake: u64,
+    ns: u64,
+}
+
+static PENDING: Mutex<Vec<Pending>> = Mutex::new(Vec::new());
+
+impl Counter {
+    pub fn reset(&mut self) {
+        self.since_reset.clear();
+        self.open = None;
+        self.counting = true;
+        self.lossy = false;
+    }
+
+    /// Byte offset to count the next draw of pass `serial` into, or None (not counting).
+    pub fn slot(&mut self, serial: u64) -> Option<usize> {
+        let buf = buffer()?;
+        if !self.counting {
+            return None;
+        }
+        if let Some((s, p)) = self.open
+            && p == serial
+        {
+            return Some(s as usize * 8);
+        }
+        if self.since_reset.len() >= MAX_INTERVAL_SLOTS {
+            self.lossy = true;
+            return None;
+        }
+        let s = self.next;
+        self.next = (self.next + 1) % SLOTS;
+        unsafe { (buf.contents().as_ptr() as *mut u64).add(s).write_volatile(0) };
+        self.since_reset.push(s as u32);
+        self.open = Some((s as u32, serial));
+        Some(s * 8)
+    }
+
+    /// A draw after a reset that could not be encoded (shader still compiling, failed program):
+    /// its samples are unknown, so the report must not read as "nothing passed".
+    pub fn draw_lost(&mut self) {
+        if self.counting {
+            self.lossy = true;
+        }
+    }
+
+    /// ReportCounter(SAMPLES_PASSED, addr) recorded into `cb`; `fake` is the old answer, used if
+    /// the interval lost draws and counted nothing.
+    pub fn report(&mut self, cb: &gfx::CommandBuffer, addr: u64, fake: u64, ns: u64) {
+        self.open = None;
+        let p = Pending { cb: Shared(cb.retain()), addr, slots: self.since_reset.clone(), lossy: self.lossy, fake, ns };
+        PENDING.lock().unwrap().push(p);
+    }
+}
+
+/// Writes the reports whose command buffers have completed. Called from command-buffer
+/// completion handlers, after the game's fence waits and at each submit.
+pub fn resolve_completed() {
+    let Some(buf) = BUFFER.as_ref() else { return };
+    let mut pending = PENDING.lock().unwrap();
+    if pending.is_empty() {
+        return;
+    }
+    let base = buf.0.contents().as_ptr() as *const u64;
+    pending.retain(|p| {
+        let st = p.cb.0.status();
+        if st != MTLCommandBufferStatus::Completed && st != MTLCommandBufferStatus::Error {
+            return true;
+        }
+        let sum: u64 = p.slots.iter().map(|&s| unsafe { base.add(s as usize).read_volatile() }).sum();
+        let value = if p.lossy && sum == 0 { p.fake } else { sum };
+        if trace() {
+            eprintln!("[occlusion] report at {:#x} = {value} ({} slots{})", p.addr, p.slots.len(), if p.lossy { ", lost draws" } else { "" });
+        }
+        if p.addr != 0 {
+            unsafe {
+                (p.addr as *mut u64).write_unaligned(value);
+                ((p.addr + 8) as *mut u64).write_unaligned(p.ns);
+            }
+        }
+        false
+    });
+}
+
+/// Adds the completion handler that resolves this command buffer's reports.
+pub fn on_commit(cb: &gfx::CommandBuffer) {
+    if !enabled() {
+        return;
+    }
+    let h = block2::RcBlock::new(|_: std::ptr::NonNull<ProtocolObject<dyn MTLCommandBuffer>>| resolve_completed());
+    unsafe { cb.addCompletedHandler(block2::RcBlock::as_ptr(&h)) };
+}
+
+use objc2::Message;
+use objc2::runtime::ProtocolObject;
