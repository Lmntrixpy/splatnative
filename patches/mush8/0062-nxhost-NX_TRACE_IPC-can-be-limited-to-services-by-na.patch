                     "[ipc] {} ({handle:#x}{}) cmd {} in {:02x?} -> {result:#x} out {:02x?} objects {}",
                     target.name(),
@@ -359,7 +377,7 @@ pub fn handle(session: &Arc<Session>, handle: u32, buf: &mut [u8]) -> bool {
         5 | 7 => {
             req.cmd = rd(buf, raw_start / 4 + 2);
             result = control(session, &req, &mut rsp);
-            if trace() {
+            if trace_name(&session.name()) {
                 eprintln!("[ipc] {} ({handle:#x}) control {} -> {result:#x}", session.name(), req.cmd);
             }
         }
@@ -374,7 +392,7 @@ pub fn handle(session: &Arc<Session>, handle: u32, buf: &mut [u8]) -> bool {
             let start = i * 4;
