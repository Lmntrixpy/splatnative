From 96b3f9cfcb2c86d3a7e2cfe6f54336d360f7776b Mon Sep 17 00:00:00 2001
From: schoeremy <jeremyfroeb2007@gmail.com>
Date: Fri, 27 Nov 2026 18:20:20 +0100
Subject: [PATCH 62/64] nxhost: NX_TRACE_IPC can be limited to services by name

NX_TRACE_IPC=1 (or empty) still traces every IPC call. A comma-separated list
of name fragments ("acc,nifm,pctl") now traces only sessions and objects
whose service name contains one of them; buffer descriptors are only logged
when tracing everything. Tracing all IPC floods the log with hid and fs
calls, which hid the few account and network calls behind Splatoon 3's
"you're offline" decision in the lobby.
---
 crates/nxhost/src/ipc.rs | 30 ++++++++++++++++++++++++------
 1 file changed, 24 insertions(+), 6 deletions(-)

diff --git a/crates/nxhost/src/ipc.rs b/crates/nxhost/src/ipc.rs
index d4d944b..885ddc4 100644
--- a/crates/nxhost/src/ipc.rs
+++ b/crates/nxhost/src/ipc.rs
@@ -214,9 +214,27 @@ pub fn new_session_handle(svc: Arc<dyn Service>) -> u32 {
     KERNEL.lock().add(Obj::Session(Session::new(svc)))
 }
 
+/// NX_TRACE_IPC=1 (or empty) traces every IPC call; a comma-separated list of name fragments
+/// ("acc,nifm,pctl") traces only services whose name contains one of them.
+fn trace_filter() -> &'static Option<Vec<String>> {
+    static T: std::sync::OnceLock<Option<Vec<String>>> = std::sync::OnceLock::new();
+    T.get_or_init(|| {
+        let v = std::env::var("NX_TRACE_IPC").ok()?;
+        let v = v.trim();
+        Some(if v.is_empty() || v == "1" { Vec::new() } else { v.split(',').map(|s| s.trim().to_string()).filter(|s| !s.is_empty()).collect() })
+    })
+}
+
+/// Tracing everything (buffer descriptors and the like).
 fn trace() -> bool {
-    static T: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
-    *T.get_or_init(|| std::env::var_os("NX_TRACE_IPC").is_some())
+    trace_filter().as_ref().is_some_and(|f| f.is_empty())
+}
+
+fn trace_name(name: &str) -> bool {
+    match trace_filter() {
+        None => false,
+        Some(f) => f.is_empty() || f.iter().any(|p| name.contains(p.as_str())),
+    }
 }
 
