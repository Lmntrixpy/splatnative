new file mode 100644
index 0000000..b5e0302
--- /dev/null
+++ b/crates/nxhost/src/nvn/abi.rs
@@ -0,0 +1,330 @@
+// SplatNative: driver-independent access to NVN builder and view structs.
+//
+// Mush8's NVN host code reads builders (TextureBuilder, SamplerBuilder, MemoryPoolBuilder,
+// BufferBuilder, WindowBuilder) and TextureViews as raw bytes in the layout of the MK8DX driver
+// (sdk ba520906): flags at 0x18, format at 0x30, sampler filters as plain u32 fields, ...
+// The rest of the host code (objects.rs, draw/*) keeps working on that "canonical" layout.
+//
+// Newer drivers lay these structs out differently. The Splatoon 3 11.3.0 driver (sdk 574284b4)
+// moves the texture builder fields (flags 0x20, format 0x38, stride 0x58, packaged layout 0x54),
+// packs sampler filters/wrap/compare into bitfields at 0x2c..0x2f and keeps texture views as a
+// flag word plus fields. Such a driver is read through its own public getter procs
+// (nvnTextureBuilderGetFormat, nvnSamplerBuilderGetWrapMode, ...), which are small leaf
+// functions in the guest sdk; each is checked to be a leaf before it is called from the host.
+// The getters' results are written into the canonical layout.
+//
+// `Native` keeps Mush8's original raw reads, so the MK8DX path is unchanged.
+
+use std::collections::HashMap;
+use std::sync::OnceLock;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum StructAbi {
+    /// The driver's structs are the canonical (MK8DX) layout: read raw.
+    Native,
+    /// Read every field through the driver's getter procs.
+    Getters,
+}
+
+macro_rules! getters {
+    ($($field:ident : $name:literal => fn($($arg:ty),*) $(-> $ret:ty)?;)*) => {
+        #[allow(dead_code)]
+        struct Getters {
+            $($field: extern "C" fn($($arg),*) $(-> $ret)?,)*
+        }
+
+        fn resolve(procs: &HashMap<String, u64>) -> anyhow::Result<Getters> {
+            Ok(Getters {
+                $($field: {
+                    let a = *procs.get($name).ok_or_else(|| anyhow::anyhow!("driver has no {}", $name))?;
+                    check_leaf($name, a)?;
+                    unsafe { std::mem::transmute::<usize, extern "C" fn($($arg),*) $(-> $ret)?>(a as usize) }
+                },)*
+            })
+        }
+    };
+}
+
+type P = *mut i32;
+type F = *mut f32;
+
+getters! {
+    tb_pool: "nvnTextureBuilderGetMemoryPool" => fn(u64) -> u64;
+    tb_offset: "nvnTextureBuilderGetMemoryOffset" => fn(u64) -> u64;
+    tb_flags: "nvnTextureBuilderGetFlags" => fn(u64) -> u32;
+    tb_target: "nvnTextureBuilderGetTarget" => fn(u64) -> u32;
+    tb_width: "nvnTextureBuilderGetWidth" => fn(u64) -> u32;
+    tb_height: "nvnTextureBuilderGetHeight" => fn(u64) -> u32;
+    tb_depth: "nvnTextureBuilderGetDepth" => fn(u64) -> u32;
+    tb_levels: "nvnTextureBuilderGetLevels" => fn(u64) -> u32;
+    tb_format: "nvnTextureBuilderGetFormat" => fn(u64) -> u32;
+    tb_samples: "nvnTextureBuilderGetSamples" => fn(u64) -> u32;
+    tb_swizzle: "nvnTextureBuilderGetSwizzle" => fn(u64, P, P, P, P);
+    tb_depth_stencil: "nvnTextureBuilderGetDepthStencilMode" => fn(u64) -> u32;
+    tb_packaged: "nvnTextureBuilderGetPackagedTextureLayout" => fn(u64, *mut u32) -> u32;
+    tb_stride: "nvnTextureBuilderGetStride" => fn(u64) -> u32;
+
+    sb_min_mag: "nvnSamplerBuilderGetMinMagFilter" => fn(u64, P, P);
+    sb_wrap: "nvnSamplerBuilderGetWrapMode" => fn(u64, P, P, P);
+    sb_lod_clamp: "nvnSamplerBuilderGetLodClamp" => fn(u64, F, F);
+    sb_lod_bias: "nvnSamplerBuilderGetLodBias" => fn(u64) -> f32;
+    sb_compare: "nvnSamplerBuilderGetCompare" => fn(u64, P, P);
+    sb_border: "nvnSamplerBuilderGetBorderColor" => fn(u64, F);
+    sb_aniso: "nvnSamplerBuilderGetMaxAnisotropy" => fn(u64) -> f32;
+    sb_reduction: "nvnSamplerBuilderGetReductionFilter" => fn(u64) -> u32;
+
+    mp_memory: "nvnMemoryPoolBuilderGetMemory" => fn(u64) -> u64;
+    mp_size: "nvnMemoryPoolBuilderGetSize" => fn(u64) -> u64;
+    mp_flags: "nvnMemoryPoolBuilderGetFlags" => fn(u64) -> u32;
+
+    bb_pool: "nvnBufferBuilderGetMemoryPool" => fn(u64) -> u64;
+    bb_offset: "nvnBufferBuilderGetMemoryOffset" => fn(u64) -> u64;
+    bb_size: "nvnBufferBuilderGetSize" => fn(u64) -> u64;
+
+    wb_num_textures: "nvnWindowBuilderGetNumTextures" => fn(u64) -> u32;
+    wb_texture: "nvnWindowBuilderGetTexture" => fn(u64, i32) -> u64;
+
+    tv_levels: "nvnTextureViewGetLevels" => fn(u64, P, P) -> u32;
+    tv_layers: "nvnTextureViewGetLayers" => fn(u64, P, P) -> u32;
+    tv_format: "nvnTextureViewGetFormat" => fn(u64, P) -> u32;
+    tv_swizzle: "nvnTextureViewGetSwizzle" => fn(u64, P, P, P, P) -> u32;
+    tv_target: "nvnTextureViewGetTarget" => fn(u64, P) -> u32;
+}
+
+static GETTERS: OnceLock<Getters> = OnceLock::new();
+
+pub(crate) fn init(abi: StructAbi, procs: &HashMap<String, u64>) -> anyhow::Result<()> {
+    if abi == StructAbi::Getters {
+        let _ = GETTERS.set(resolve(procs)?);
+    }
+    Ok(())
+}
+
+/// True when the driver's structs are read through getters (layout differs from MK8DX's).
+pub(crate) fn uses_getters() -> bool {
+    GETTERS.get().is_some()
+}
+
+/// A getter may only be called from the host if it is a self-contained leaf: every instruction
+/// reachable from its entry (following fall-through and conditional branches) must be an
+/// ordinary instruction or a plain `ret`; no calls, no unconditional branches (nxpatch reaches
+/// its trampolines through those), no system instructions, all within 64 instructions.
+fn check_leaf(name: &str, addr: u64) -> anyhow::Result<()> {
+    let words = unsafe { std::slice::from_raw_parts(addr as *const u32, LEAF_WINDOW) };
+    leaf_words(words).map_err(|i| anyhow::anyhow!("{name} at {addr:#x}: instruction {i} is not leaf-safe"))
+}
+
+const LEAF_WINDOW: usize = 64;
+const RET: u32 = 0xd65f_03c0;
+
+/// Ok if every reachable instruction is leaf-safe; Err(index) of the first one that is not
+/// (or that runs off the window).
+fn leaf_words(words: &[u32]) -> Result<(), usize> {
+    let mut seen = vec![false; words.len()];
+    let mut todo = vec![0i64];
+    while let Some(i) = todo.pop() {
+        let Some(&w) = usize::try_from(i).ok().and_then(|u| words.get(u)) else { return Err(i.max(0) as usize) };
+        if std::mem::replace(&mut seen[i as usize], true) {
+            continue;
+        }
+        let cond = if w & 0xff00_0010 == 0x5400_0000 || w & 0x7e00_0000 == 0x3400_0000 {
+            Some(sext((w >> 5) & 0x7ffff, 19)) // b.cond, cbz/cbnz
+        } else if w & 0x7e00_0000 == 0x3600_0000 {
+            Some(sext((w >> 5) & 0x3fff, 14)) // tbz/tbnz
+        } else {
+            None
+        };
+        if w == RET {
+            continue;
+        }
+        let unsafe_op = w & 0x7c00_0000 == 0x1400_0000 // b / bl
+            || w & 0xfe00_0000 == 0xd600_0000 // br / blr / ret xN / eret
+            || w & 0xffc0_0000 == 0xd500_0000 // system instructions (mrs/msr/barriers/hints)
+            || w & 0xff00_0000 == 0xd400_0000; // svc / hvc / smc / brk
+        if unsafe_op && w != 0xd503_201f {
+            return Err(i as usize);
+        }
+        if let Some(off) = cond {
+            todo.push(i + off);
+        }
+        todo.push(i + 1);
+    }
+    Ok(())
+}
+
+fn sext(v: u32, bits: u32) -> i64 {
+    ((v as i64) << (64 - bits)) >> (64 - bits)
+}
+
+fn g() -> Option<&'static Getters> {
+    GETTERS.get()
+}
+
+fn raw<const N: usize>(addr: u64) -> [u8; N] {
+    let mut b = [0u8; N];
+    unsafe { std::ptr::copy_nonoverlapping(addr as *const u8, b.as_mut_ptr(), N) };
+    b
+}
+
+fn rd<T: Copy>(addr: u64) -> T {
+    unsafe { (addr as *const T).read_unaligned() }
+}
+
+fn put<T: Copy, const N: usize>(b: &mut [u8; N], off: usize, v: T) {
+    unsafe { (b.as_mut_ptr().add(off) as *mut T).write_unaligned(v) };
+}
+
+/// Canonical texture builder: pool 0x08, offset 0x10, flags 0x18, target 0x1c, width 0x20,
+/// height 0x24, depth 0x28, levels 0x2c, format 0x30, samples 0x34, swizzle 0x38..0x48,
+/// depth-stencil mode 0x48, packaged layout 0x58 (bit 0 set, layout << 4), stride 0x5c.
+pub(crate) fn texture_builder(guest: u64) -> [u8; 0x68] {
+    let Some(g) = g() else { return raw(guest) };
+    let mut b = [0u8; 0x68];
+    put(&mut b, 0x08, (g.tb_pool)(guest));
+    put(&mut b, 0x10, (g.tb_offset)(guest));
+    let fields = [g.tb_flags, g.tb_target, g.tb_width, g.tb_height, g.tb_depth, g.tb_levels, g.tb_format, g.tb_samples];
+    for (i, f) in fields.iter().enumerate() {
+        put(&mut b, 0x18 + 4 * i, f(guest));
+    }
+    let mut s = [0i32; 4];
+    (g.tb_swizzle)(guest, &mut s[0], &mut s[1], &mut s[2], &mut s[3]);
+    for (i, v) in s.iter().enumerate() {
+        put(&mut b, 0x38 + 4 * i, *v);
+    }
+    put(&mut b, 0x48, (g.tb_depth_stencil)(guest));
+    let mut layout = 0u32;
+    if (g.tb_packaged)(guest, &mut layout) & 0xff != 0 {
+        put(&mut b, 0x58, (1 | layout << 4) as u16);
+    }
+    put(&mut b, 0x5c, (g.tb_stride)(guest));
+    b
+}
+
+/// Canonical sampler builder: min 0x08, mag 0x0c, wrap s/t/r 0x10..0x1c, lod clamp 0x1c/0x20,
+/// lod bias 0x24, compare mode 0x28, compare func 0x2c, border color 0x30..0x40, anisotropy 0x40.
+/// Drivers read through getters also get the reduction filter at 0x44 (SAMPLER_REDUCTION).
+pub(crate) fn sampler_builder(guest: u64) -> [u8; 0x60] {
+    let Some(g) = g() else { return raw(guest) };
+    let mut b = [0u8; 0x60];
+    let mut v = [0i32; 3];
+    (g.sb_min_mag)(guest, &mut v[0], &mut v[1]);
+    put(&mut b, 0x08, v[0]);
+    put(&mut b, 0x0c, v[1]);
+    (g.sb_wrap)(guest, &mut v[0], &mut v[1], &mut v[2]);
+    for (i, w) in v.iter().enumerate() {
+        put(&mut b, 0x10 + 4 * i, *w);
+    }
+    let mut f = [0f32; 4];
+    (g.sb_lod_clamp)(guest, &mut f[0], &mut f[1]);
+    put(&mut b, 0x1c, f[0]);
+    put(&mut b, 0x20, f[1]);
+    put(&mut b, 0x24, (g.sb_lod_bias)(guest));
+    (g.sb_compare)(guest, &mut v[0], &mut v[1]);
+    put(&mut b, 0x28, v[0]);
+    put(&mut b, 0x2c, v[1]);
+    (g.sb_border)(guest, f.as_mut_ptr());
+    for (i, c) in f.iter().enumerate() {
+        put(&mut b, 0x30 + 4 * i, *c);
+    }
+    put(&mut b, 0x40, (g.sb_aniso)(guest));
+    put(&mut b, SAMPLER_REDUCTION, (g.sb_reduction)(guest));
+    b
+}
+
+pub(crate) const SAMPLER_REDUCTION: usize = 0x44;
+
+/// (CPU memory, size, flags) of a memory pool builder.
+pub(crate) fn memory_pool_builder(guest: u64) -> (u64, u64, u32) {
+    match g() {
+        Some(g) => ((g.mp_memory)(guest), (g.mp_size)(guest), (g.mp_flags)(guest)),
+        None => (rd(guest + 8), rd(guest + 0x10), rd(guest + 0x18)),
+    }
+}
+
+/// (pool, offset, size) of a buffer builder.
+pub(crate) fn buffer_builder(guest: u64) -> (u64, u64, u64) {
+    match g() {
+        Some(g) => ((g.bb_pool)(guest), (g.bb_offset)(guest), (g.bb_size)(guest)),
+        None => (rd(guest + 8), rd(guest + 0x10), rd(guest + 0x18)),
+    }
+}
+
+/// The textures a window builder was given.
+pub(crate) fn window_textures(guest: u64) -> Vec<u64> {
+    match g() {
+        Some(g) => (0..(g.wb_num_textures)(guest) as i32).map(|i| (g.wb_texture)(guest, i)).collect(),
+        None => {
+            let (count, list): (u32, u64) = (rd(guest + 8), rd(guest + 0x10));
+            (0..count as u64).map(|i| rd::<u64>(list + 8 * i)).collect()
+        }
+    }
+}
+
+pub(crate) const VIEW_LEVELS: u8 = 1;
+pub(crate) const VIEW_LAYERS: u8 = 2;
+pub(crate) const VIEW_FORMAT: u8 = 4;
+pub(crate) const VIEW_SWIZZLE: u8 = 8;
+pub(crate) const VIEW_TARGET: u8 = 0x20;
+
+/// Canonical texture view: set-flags 0x00, base level 0x01, base layer 0x04 (u16), format 0x08,
+/// swizzle 0x0c..0x1c, target 0x20.
+pub(crate) fn texture_view(guest: u64) -> [u8; 0x24] {
+    let Some(g) = g() else { return raw(guest) };
+    let mut b = [0u8; 0x24];
+    let mut flags = 0u8;
+    let mut v = [0i32; 4];
+    if (g.tv_levels)(guest, &mut v[0], &mut v[1]) & 1 != 0 {
+        flags |= VIEW_LEVELS;
+        b[1] = v[0] as u8;
+    }
+    if (g.tv_layers)(guest, &mut v[0], &mut v[1]) & 1 != 0 {
+        flags |= VIEW_LAYERS;
+        put(&mut b, 4, v[0] as u16);
+    }
+    if (g.tv_format)(guest, &mut v[0]) & 1 != 0 {
+        flags |= VIEW_FORMAT;
+        put(&mut b, 8, v[0]);
+    }
+    if (g.tv_swizzle)(guest, &mut v[0], &mut v[1], &mut v[2], &mut v[3]) & 1 != 0 {
+        flags |= VIEW_SWIZZLE;
+        for (i, s) in v.iter().enumerate() {
+            put(&mut b, 0xc + 4 * i, *s);
+        }
+    }
+    if (g.tv_target)(guest, &mut v[0]) & 1 != 0 {
+        flags |= VIEW_TARGET;
+        put(&mut b, 0x20, v[0]);
+    }
+    b[0] = flags;
+    b
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn leaf_check_accepts_getters_and_rejects_calls() {
+        // nvnTextureBuilderGetStride (sdk 574284b4 0x4d18d0): ldr w0, [x0, #0x58]; ret
+        assert_eq!(leaf_words(&[0xb9405800, 0xd65f03c0]), Ok(()));
+        // nvnTextureBuilderGetPackagedTextureLayout's shape: b.eq to a second tail past the
+        // first ret (str wzr; ldrh; tst; b.eq +2; ret; and; and; ret)
+        assert_eq!(leaf_words(&[0xb900003f, 0x7940a808, 0x72000d1f, 0x54000040, 0xd65f03c0, 0x12001d08, 0x12000d00, 0xd65f03c0]), Ok(()));
+        // a branch out of the window, falling off the window, bl, blr x8, svc, unconditional b
+        assert_eq!(leaf_words(&[0x54000200, 0xd65f03c0]), Err(16));
+        assert_eq!(leaf_words(&[0xb9405800]), Err(1));
+        assert_eq!(leaf_words(&[0x94000010, 0xd65f03c0]), Err(0));
+        assert_eq!(leaf_words(&[0xd63f0100, 0xd65f03c0]), Err(0));
+        assert_eq!(leaf_words(&[0xd4000001, 0xd65f03c0]), Err(0));
+        assert_eq!(leaf_words(&[0x14000001, 0xd65f03c0]), Err(0));
+        // mrs x0, tpidrro_el0 (rewritten by nxpatch, never leaf-safe)
+        assert_eq!(leaf_words(&[0xd53bd060, 0xd65f03c0]), Err(0));
+    }
+
+    #[test]
+    fn sext_signs() {
+        assert_eq!(sext(0x7ffff, 19), -1);
+        assert_eq!(sext(2, 19), 2);
+        assert_eq!(sext(0x2000, 14), -0x2000);
+    }
+}
