+/// Load order of Horizon ExeFS modules: main, subsdk0..subsdk9, sdk. rtld is never run.
+pub const MODULE_ORDER: [&str; 12] = ["main", "subsdk0", "subsdk1", "subsdk2", "subsdk3", "subsdk4", "subsdk5", "subsdk6", "subsdk7", "subsdk8", "subsdk9", "sdk"];
+
+/// The prepared modules present in `dir` (those with a `.layout`), in load order.
+/// MK8DX has main, subsdk0, sdk; Splatoon 3 has main, sdk.
+pub fn module_names(dir: &Path) -> Result<Vec<&'static str>> {
+    let names: Vec<&'static str> = MODULE_ORDER.iter().copied().filter(|n| dir.join(format!("{n}.layout")).exists()).collect();
+    ensure!(names.first() == Some(&"main"), "{}: no prepared main module (main.layout)", dir.display());
+    Ok(names)
+}
+
