+#[cfg(test)]
+mod module_order_tests {
+    use super::module_names;
+
+    #[test]
+    fn module_names_follow_horizon_load_order() {
+        let dir = std::env::temp_dir().join(format!("nxhost-modules-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        for n in ["sdk", "main", "subsdk1", "rtld"] {
+            std::fs::write(dir.join(format!("{n}.layout")), "").unwrap();
+        }
+        assert_eq!(module_names(&dir).unwrap(), ["main", "subsdk1", "sdk"]);
+        std::fs::remove_file(dir.join("main.layout")).unwrap();
+        assert!(module_names(&dir).is_err());
+        std::fs::remove_dir_all(&dir).unwrap();
+    }
+}
