From 280c9cbe911a150b21769298cb84743bd289178c Mon Sep 17 00:00:00 2001
From: schoeremy <jeremyfroeb2007@gmail.com>
Date: Fri, 27 Nov 2026 10:20:40 +0100
Subject: [PATCH 53/61] nxhost: emulate Horizon's eventfd; let launchers pick
 the renewed Nextendo sign-in file

bsd cmd 31 (EventFd) was a stub that answered success with a bogus fd.
Splatoon 3's gRPC wakes its poll loop through an eventfd, so as soon as nifm
reported a network (LAN, Lan-Play, Nextendo) the game polled a dead
descriptor forever and stayed on the loading screen (60 textures after
150 s). An eventfd is now a counter plus a host socket pair whose read end
holds one byte while the counter is non-zero: select/poll on the guest fd
work unchanged, read/write/close follow eventfd semantics (EFD_SEMAPHORE,
EFD_NONBLOCK). Splatoon 3 now reaches the lobby in LAN and Nextendo mode.

NX_NEXTENDO_REFRESH_FILE overrides where the renewed refresh token is saved
(default: Mush8's Application Support folder), so the SplatNative launcher
keeps its sign-in across game sessions.
---
 crates/nxhost/src/services/bsd.rs    | 138 ++++++++++++++++++++++++++-
 crates/nxhost/src/services/nexweb.rs |  13 ++-
 2 files changed, 147 insertions(+), 4 deletions(-)

diff --git a/crates/nxhost/src/services/bsd.rs b/crates/nxhost/src/services/bsd.rs
index 31d1405..d556e1e 100644
--- a/crates/nxhost/src/services/bsd.rs
+++ b/crates/nxhost/src/services/bsd.rs
@@ -11,6 +11,111 @@ use std::time::{Duration, Instant};
 enum Fd {
     Host(i32),
     Virt(Arc<vnet::Socket>),
+    Event(Arc<EventFd>),
+}
+
+/// Horizon's eventfd (bsd cmd 31), which macOS lacks. gRPC wakes its poll loop with one; a
+/// stub left Splatoon 3 polling a dead descriptor forever, stuck on the loading screen as soon
+/// as a network was up. A counter plus a socket pair: `r` holds one byte while the counter is
+/// non-zero, so select/poll on the guest fd (mapped to `r`) see it readable.
+struct EventFd {
+    r: i32,
+    w: i32,
+    count: Mutex<u64>,
+    semaphore: bool,
+}
+
+const EFD_SEMAPHORE: u32 = 1;
+const EFD_NONBLOCK: u32 = 4;
+
+impl EventFd {
+    fn new(init: u64, flags: u32) -> Option<EventFd> {
+        let mut sv = [0i32; 2];
+        if unsafe { libc::socketpair(libc::AF_UNIX, libc::SOCK_STREAM, 0, sv.as_mut_ptr()) } != 0 {
+            return None;
+        }
+        unsafe {
+            libc::fcntl(sv[1], libc::F_SETFL, libc::O_NONBLOCK);
+            if flags & EFD_NONBLOCK != 0 {
+                libc::fcntl(sv[0], libc::F_SETFL, libc::O_NONBLOCK);
+            }
+        }
+        let e = EventFd { r: sv[0], w: sv[1], count: Mutex::new(0), semaphore: flags & EFD_SEMAPHORE != 0 };
+        e.add(init);
+        Some(e)
+    }
+
+    fn add(&self, v: u64) {
+        let mut c = self.count.lock().unwrap();
+        let was = *c;
+        *c = c.saturating_add(v).min(u64::MAX - 1);
+        if was == 0 && *c > 0 {
+            unsafe { libc::write(self.w, [1u8].as_ptr().cast(), 1) };
+        }
+    }
+
+    fn take(&self) -> Option<u64> {
+        let mut c = self.count.lock().unwrap();
+        if *c == 0 {
+            return None;
+        }
+        let v = if self.semaphore { 1 } else { *c };
+        *c -= v;
+        if *c == 0 {
+            let mut b = [0u8; 16];
+            while (unsafe { libc::recv(self.r, b.as_mut_ptr().cast(), b.len(), libc::MSG_DONTWAIT) }) > 0 {}
+        }
+        Some(v)
+    }
+
+    fn nonblocking(&self) -> bool {
+        (unsafe { libc::fcntl(self.r, libc::F_GETFL) }) & libc::O_NONBLOCK != 0
+    }
+
+    /// read(2): 8 bytes of counter, EAGAIN when empty and non-blocking, else waits.
+    fn read(&self, dst: &mut [u8]) -> (i32, u32) {
+        if dst.len() < 8 {
+            return (-1, linux_errno(libc::EINVAL));
+        }
+        loop {
+            if let Some(v) = self.take() {
+                dst[..8].copy_from_slice(&v.to_le_bytes());
+                return (8, 0);
+            }
+            if self.nonblocking() {
+                return (-1, linux_errno(libc::EAGAIN));
+            }
+            let mut p = libc::pollfd { fd: self.r, events: libc::POLLIN, revents: 0 };
+            crate::kernel::blocking(|| unsafe { libc::poll(&mut p, 1, -1) });
+        }
+    }
+
+    fn write(&self, src: &[u8]) -> (i32, u32) {
+        let Some(v) = src.get(..8).map(|b| u64::from_le_bytes(b.try_into().unwrap())) else {
+            return (-1, linux_errno(libc::EINVAL));
+        };
+        if v == u64::MAX {
+            return (-1, linux_errno(libc::EINVAL));
+        }
+        self.add(v);
+        (8, 0)
+    }
+}
+
+impl Drop for EventFd {
+    fn drop(&mut self) {
+        unsafe {
+            libc::close(self.r);
+            libc::close(self.w);
+        }
+    }
+}
+
+fn event(g: i32) -> Option<Arc<EventFd>> {
+    match entry(g) {
+        Some(Fd::Event(e)) => Some(e),
+        _ => None,
+    }
 }
 
 static FDS: Mutex<Vec<Option<Fd>>> = Mutex::new(Vec::new());
@@ -22,6 +127,7 @@ fn entry(g: i32) -> Option<Fd> {
 pub(super) fn host(g: i32) -> Option<i32> {
     match entry(g) {
         Some(Fd::Host(h)) => Some(h),
+        Some(Fd::Event(e)) => Some(e.r),
         _ => None,
     }
 }
@@ -355,6 +461,35 @@ impl Service for Bsd {
                 return virt_call(&s, gfd, req, rsp);
             }
         }
+        if let Some(e) = event(gfd).filter(|_| matches!(req.cmd, 8 | 10 | 24 | 25 | 26)) {
+            let r = match req.cmd {
+                8 | 25 => e.read(bytes_mut(out_buf(req, 0))),
+                10 | 24 => e.write(bytes(in_buf(req, 0))),
+                _ => {
+                    release(gfd);
+                    (0, 0)
+                }
+            };
+            if trace() {
+                eprintln!("[bsd] eventfd cmd {} fd {gfd} -> {} errno {}", req.cmd, r.0, r.1);
+            }
+            rsp.push_u32(r.0 as u32);
+            rsp.push_u32(r.1);
+            return 0;
+        }
+        if req.cmd == 31 {
+            let (init, flags) = (req.u64(0), req.u32(8));
+            let r = match EventFd::new(init, flags) {
+                Some(e) => (adopt(Fd::Event(Arc::new(e))), 0),
+                None => res(-1),
+            };
+            if trace() {
+                eprintln!("[bsd] eventfd({init}, {flags:#x}) -> {} errno {}", r.0, r.1);
+            }
+            rsp.push_u32(r.0 as u32);
+            rsp.push_u32(r.1);
+            return 0;
+        }
         if (req.cmd == 5 || req.cmd == 6) && vnet::mode().is_virtual() {
             return virt_wait(req, rsp);
         }
@@ -594,6 +729,7 @@ impl Service for Bsd {
                             s.shutdown();
                             0
                         }
+                        Fd::Event(_) => 0,
                     };
                 }
                 (0, 0)
@@ -754,7 +890,7 @@ fn ready_now(wants: &[(i32, i16)]) -> Vec<i16> {
     }
     wants.iter().zip(&hosts).map(|(&(g, events), p)| match entry(g) {
         Some(Fd::Virt(s)) => s.poll(events),
-        Some(Fd::Host(_)) => p.revents,
+        Some(Fd::Host(_)) | Some(Fd::Event(_)) => p.revents,
         None => vnet::POLLNVAL,
     }).collect()
 }
diff --git a/crates/nxhost/src/services/nexweb.rs b/crates/nxhost/src/services/nexweb.rs
index 2f7fec3..c60bfed 100644
--- a/crates/nxhost/src/services/nexweb.rs
+++ b/crates/nxhost/src/services/nexweb.rs
@@ -74,9 +74,16 @@ fn renewed_access() -> Option<String> {
 fn save_refresh(token: &str) {
     use std::io::Write;
     use std::os::unix::fs::OpenOptionsExt;
-    let Some(home) = std::env::var_os("HOME") else { return };
-    let dir = std::path::Path::new(&home).join("Library/Application Support/Mush8");
-    let (tmp, file) = (dir.join("nextendo-refresh.tmp"), dir.join("nextendo-refresh"));
+    // NX_NEXTENDO_REFRESH_FILE lets another launcher (SplatNative) pick the renewed sign-in up.
+    let file = match std::env::var_os("NX_NEXTENDO_REFRESH_FILE").filter(|f| !f.is_empty()) {
+        Some(f) => std::path::PathBuf::from(f),
+        None => {
+            let Some(home) = std::env::var_os("HOME") else { return };
+            std::path::Path::new(&home).join("Library/Application Support/Mush8/nextendo-refresh")
+        }
+    };
+    let Some(dir) = file.parent().map(std::path::Path::to_path_buf) else { return };
+    let tmp = file.with_extension("tmp");
     let saved = std::fs::create_dir_all(&dir).and_then(|_| {
         let _ = std::fs::remove_file(&tmp);
         let mut f = std::fs::OpenOptions::new().write(true).create_new(true).mode(0o600).open(&tmp)?;
-- 
