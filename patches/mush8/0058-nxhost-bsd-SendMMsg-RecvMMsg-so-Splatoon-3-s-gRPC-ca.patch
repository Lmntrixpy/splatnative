+                return 0;
+            }
             _ => return Stub(self.name()).call(req, rsp),
         };
         if trace() {
@@ -762,6 +778,99 @@ impl Service for Bsd {
     }
 }
 
+/// One message of the serialized mmsghdr array that bsd SendMMsg/RecvMMsg (cmds 30/29) take in
+/// their in/out buffer, as seen from Splatoon 3's gRPC (sendmsg on a connected TCP socket):
+/// u32 8, u8 0 (no address), u32 iov count, per iov u64 length + bytes, then a 12-byte trailer
+/// (control length, flags, and the message's sent length in the last u32).
+struct MsgLayout {
+    iovs: Vec<(usize, usize)>,
+    len_at: usize,
+    end: usize,
+}
+
+fn parse_msg(b: &[u8], at: usize) -> Option<MsgLayout> {
+    let u32_at = |o: usize| b.get(o..o + 4).map(|x| u32::from_le_bytes(x.try_into().unwrap()) as usize);
+    let u64_at = |o: usize| b.get(o..o + 8).map(|x| u64::from_le_bytes(x.try_into().unwrap()) as usize);
+    let _ = u32_at(at)?;
+    let has_name = *b.get(at + 4)?;
+    if has_name != 0 {
+        return None;
+    }
+    let mut p = at + 5;
+    let count = u32_at(p)?;
+    p += 4;
+    let mut iovs = Vec::new();
+    for _ in 0..count.min(64) {
+        let len = u64_at(p)?;
+        p += 8;
+        b.get(p..p + len)?;
+        iovs.push((p, len));
+        p += len;
+    }
+    let end = p + 12;
+    b.get(p..end)?;
+    Some(MsgLayout { iovs, len_at: end - 4, end })
+}
+
+fn send_mmsg(fd: i32, vlen: usize, flags: i32, b: &mut [u8]) -> (i32, u32) {
+    let mut at = 0;
+    let mut sent = 0;
+    for _ in 0..vlen {
+        let Some(m) = parse_msg(b, at) else {
+            eprintln!("[bsd] sendmmsg: message {sent} not understood: {}", b.iter().skip(at).take(32).map(|x| format!("{x:02x}")).collect::<String>());
+            return if sent > 0 { (sent, 0) } else { (-1, linux_errno(libc::EINVAL)) };
+        };
+        let data: Vec<u8> = m.iovs.iter().flat_map(|&(o, l)| b[o..o + l].iter().copied()).collect();
+        let n = crate::kernel::blocking(|| unsafe { libc::send(fd, data.as_ptr().cast(), data.len(), flags) });
+        if n < 0 {
+            let e = res(-1);
+            return if sent > 0 { (sent, 0) } else { e };
+        }
+        b[m.len_at..m.len_at + 4].copy_from_slice(&(n as u32).to_le_bytes());
+        sent += 1;
+        at = m.end;
+        if (n as usize) < data.len() {
+            break;
+        }
+    }
+    (sent, 0)
+}
+
+/// RecvMMsg: the same layout, with each iov's length naming the room behind it. Received bytes
+/// go into that room and their count into the message's length field; only the first message
+/// may block, like recvmmsg(2).
+fn recv_mmsg(fd: i32, vlen: usize, flags: i32, b: &mut [u8]) -> (i32, u32) {
+    let mut at = 0;
+    let mut got = 0;
+    for i in 0..vlen {
+        let Some(m) = parse_msg(b, at) else {
+            eprintln!("[bsd] recvmmsg: message {got} not understood: {}", b.iter().skip(at).take(32).map(|x| format!("{x:02x}")).collect::<String>());
+            return if got > 0 { (got, 0) } else { (-1, linux_errno(libc::EINVAL)) };
+        };
+        let room: usize = m.iovs.iter().map(|&(_, l)| l).sum();
+        let mut tmp = vec![0u8; room];
+        let f = if i == 0 { flags } else { flags | libc::MSG_DONTWAIT };
+        let n = crate::kernel::blocking(|| unsafe { libc::recv(fd, tmp.as_mut_ptr().cast(), room, f) });
+        if n < 0 {
+            let e = res(-1);
+            return if got > 0 { (got, 0) } else { e };
+        }
+        let mut left = &tmp[..n as usize];
+        for &(o, l) in &m.iovs {
+            let k = left.len().min(l);
+            b[o..o + k].copy_from_slice(&left[..k]);
+            left = &left[k..];
+        }
+        b[m.len_at..m.len_at + 4].copy_from_slice(&(n as u32).to_le_bytes());
+        got += 1;
+        at = m.end;
+        if n == 0 {
+            break;
+        }
+    }
+    (got, 0)
+}
+
 fn guest_v4(b: &[u8]) -> Option<SocketAddrV4> {
     (b.len() >= 8 && i32::from(b[1]) == libc::AF_INET).then(|| SocketAddrV4::new(Ipv4Addr::new(b[4], b[5], b[6], b[7]), u16::from_be_bytes([b[2], b[3]])))
 }
