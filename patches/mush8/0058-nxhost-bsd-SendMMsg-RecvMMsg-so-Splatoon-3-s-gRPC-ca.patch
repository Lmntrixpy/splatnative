+
+/// The Nextendo server; NX_NEXTENDO_SERVER points the redirects elsewhere (a local test server).
+fn server() -> Ipv4Addr {
+    static S: OnceLock<Ipv4Addr> = OnceLock::new();
+    *S.get_or_init(|| std::env::var("NX_NEXTENDO_SERVER").ok().and_then(|v| v.trim().parse().ok()).unwrap_or(SERVER))
+}
 const NAT: Ipv4Addr = Ipv4Addr::new(164, 132, 111, 120);
 const BAAS: &str = "e0d67c509fb203858ebcb2fe3f88c2aa.baas.nintendo.com";
 
@@ -42,10 +48,10 @@ pub fn redirect(host: &str) -> Option<Ipv4Addr> {
