+/// NX_NEXTENDO_INSPECT: send the game's TLS connection to the Nextendo server through the local
+/// decoding relay (inspect.rs).
+#[cfg(target_os = "macos")]
+fn divert_to_inspector(ss: &mut libc::sockaddr_storage) {
+    let Some(ip) = v4(ss) else { return };
+    let port = u16::from_be(unsafe { (*(ss as *const _ as *const libc::sockaddr_in)).sin_port });
+    if let Some(to) = super::inspect::divert(SocketAddrV4::new(Ipv4Addr::from(ip), port)) {
+        set_v4(ss, to.ip().octets());
+        unsafe { (*(ss as *mut _ as *mut libc::sockaddr_in)).sin_port = to.port().to_be() };
+    }
+}
