+/// ectx's IContextRegistrar: the SDK files an error's context here before showing it. Splatoon 3
+/// does so when going online fails; without the object nn::err dereferenced null. The result
+/// code is logged, which is the useful part.
+fn error_context() -> Arc<dyn Service> {
+    Arc::new(ErrorContext)
+}
+
+struct ErrorContext;
+
+impl Service for ErrorContext {
+    fn name(&self) -> String {
+        "ectx::IContextRegistrar".into()
+    }
+    fn call(&self, req: &crate::ipc::Request, _rsp: &mut crate::ipc::Response) -> u32 {
+        if req.cmd == 0 {
+            let r = req.u32(0);
+            eprintln!("[ectx] the game reports error {:04}-{:04} (result {r:#x})", 2000 + (r & 0x1ff), (r >> 9) & 0x1fff);
+        }
+        0
+    }
+}
+
+/// ntc's IEnsureNetworkClockAvailabilityService. The network clock in time:u already follows
+/// the host's clock, so the check finishes at once and succeeds. Splatoon 3 opens it on its way
+/// online (nn::time::AsyncEnsureNetworkClockAvailabilityTask); without the object the SDK
+/// dereferenced null.
+fn ensure_network_clock() -> Arc<dyn Service> {
+    Arc::new(EnsureNetworkClock)
+}
+
+struct EnsureNetworkClock;
+
+impl Service for EnsureNetworkClock {
+    fn name(&self) -> String {
+        "ntc::IEnsureNetworkClockAvailabilityService".into()
+    }
+    fn call(&self, req: &crate::ipc::Request, rsp: &mut crate::ipc::Response) -> u32 {
+        match req.cmd {
+            0 | 2 | 3 => {}
+            1 => rsp.copy_handles.push(crate::ipc::new_event(true)),
+            4 => rsp.data.push(0),
+            5 => {
+                let now = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map_or(0, |d| d.as_secs());
+                rsp.push_u64(now);
+            }
+            _ => return Stub(self.name()).call(req, rsp),
+        }
+        0
+    }
+}
