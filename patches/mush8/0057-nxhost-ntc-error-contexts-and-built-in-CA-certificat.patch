+/// One entry of the console's trusted CA store (system data 0100000000000800,
+/// ssl_TrustedCerts.bdf): id, status, DER bytes.
+struct BuiltInCert {
+    id: u32,
+    status: u32,
+    der: Vec<u8>,
+}
+
+const CERT_STORE: u64 = 0x0100_0000_0000_0800;
+const ALL_CERTS: u32 = u32::MAX;
+
+/// "sslT" header (magic, count), then 16-byte entries (id, status, size, offset) with offsets
+/// counted from the end of the 8-byte header (the first one equals the table size). Splatoon 3 runs its own BoringSSL and asks
+/// nn::ssl for these roots (GetCertificates); an empty answer made it give up before
+/// connecting.
+fn builtin_certs() -> &'static [BuiltInCert] {
+    static C: OnceLock<Vec<BuiltInCert>> = OnceLock::new();
+    C.get_or_init(|| {
+        let file = super::fs::CONFIG.get().and_then(|cfg| super::fs::system_data(cfg, CERT_STORE)).and_then(|s| {
+            let fs = nxfs::romfs::RomFs::open(s).ok()?;
+            let f = fs.files().into_iter().find(|f| f.path.ends_with("ssl_TrustedCerts.bdf"))?;
+            fs.storage().read_vec(f.offset, f.size as usize).ok()
+        });
+        let Some(d) = file else {
+            eprintln!("[ssl] built-in certificates unavailable: no ssl_TrustedCerts.bdf in the firmware (0100000000000800)");
+            return Vec::new();
+        };
+        let u32_at = |o: usize| d.get(o..o + 4).map(|b| u32::from_le_bytes(b.try_into().unwrap()));
+        let (Some(magic), Some(count)) = (u32_at(0), u32_at(4)) else { return Vec::new() };
+        let data_start = 8;
+        let mut out = Vec::new();
+        for i in 0..count as usize {
+            let e = 8 + i * 16;
+            let (Some(id), Some(status), Some(size), Some(off)) = (u32_at(e), u32_at(e + 4), u32_at(e + 8), u32_at(e + 12)) else { break };
+            let Some(der) = d.get(data_start + off as usize..data_start + off as usize + size as usize) else { break };
+            out.push(BuiltInCert { id, status, der: der.to_vec() });
+        }
+        let der_like = out.iter().filter(|c| c.der.first() == Some(&0x30)).count();
+        eprintln!("[ssl] {} built-in certificates from the firmware (magic {magic:#x}, {der_like} look like DER)", out.len());
+        if der_like != out.len() || out.is_empty() {
+            let head: String = d.iter().take(48).map(|b| format!("{b:02x}")).collect();
+            eprintln!("[ssl] certificate store layout not understood, first bytes {head}");
+        }
+        out
+    })
+}
+
+fn requested(req: &Request) -> Vec<&'static BuiltInCert> {
+    let ids: Vec<u32> = bytes(in_buf(req, 0)).chunks_exact(4).map(|c| u32::from_le_bytes(c.try_into().unwrap())).collect();
+    let all = builtin_certs();
+    let picked: Vec<_> = if ids.contains(&ALL_CERTS) { all.iter().collect() } else { all.iter().filter(|c| ids.contains(&c.id)).collect() };
+    nextendo::diag_once(&format!("certs{ids:?}"), || format!("[ssl] built-in certificates asked for {ids:x?}: {} of {}", picked.len(), all.len()));
+    picked
+}
+
+/// GetCertificates' layout: one 0x18-byte BuiltInCertificateInfo per certificate (id, status,
+/// size, offset from the buffer start), then the DER data.
+fn builtin_blob(certs: &[&BuiltInCert]) -> Vec<u8> {
+    let mut out = vec![0u8; certs.len() * 0x18];
+    for (i, c) in certs.iter().enumerate() {
+        let off = out.len() as u64;
+        let e = i * 0x18;
+        out[e..e + 4].copy_from_slice(&c.id.to_le_bytes());
+        out[e + 4..e + 8].copy_from_slice(&c.status.to_le_bytes());
+        out[e + 8..e + 16].copy_from_slice(&(c.der.len() as u64).to_le_bytes());
+        out[e + 16..e + 24].copy_from_slice(&off.to_le_bytes());
+        out.extend_from_slice(&c.der);
+    }
+    out
+}
+
 struct Context;
 
 impl Service for Context {
