index 32dd498..88da794 100644
--- a/crates/nxshader/src/msl.rs
+++ b/crates/nxshader/src/msl.rs
@@ -115,6 +115,7 @@ struct Gen<'a> {
     preds: BTreeSet<i32>,
     uses_cc: bool,
     uses_lmem: bool,
+    uses_smem: bool,
