+    case 29u: f.xyz = float3(*(const AS packed_half3*)p); break; \
+    case 41u: f = float4(*(const AS packed_half4*)p); break; \
+    case 6u: f.x = float(*(const AS ushort*)p) / 65535.0f; break; \
+    case 18u: f.xy = float2(*(const AS packed_ushort2*)p) / 65535.0f; break; \
+    case 30u: f.xyz = float3(*(const AS packed_ushort3*)p) / 65535.0f; break; \
+    case 42u: f = float4(*(const AS packed_ushort4*)p) / 65535.0f; break; \
+    case 7u: f.x = max(float(*(const AS short*)p) / 32767.0f, -1.0f); break; \
+    case 19u: f.xy = max(float2(*(const AS packed_short2*)p) / 32767.0f, -1.0f); break; \
+    case 31u: f.xyz = max(float3(*(const AS packed_short3*)p) / 32767.0f, -1.0f); break; \
