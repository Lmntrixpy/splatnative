+    case 101u: f = float4(*(const AS packed_ushort4*)p); break; \
+    case 102u: f = float4(*(const AS packed_short4*)p); break; \
+    case 103u: f = float4(*(const AS packed_uint4*)p); break; \
+    case 104u: f = float4(*(const AS packed_int4*)p); break; \
+    case 105u: case 106u: case 108u: { \
+        int v = *(const AS int*)p; \
+        int4 c = int4((v << 22) >> 22, (v << 12) >> 22, (v << 2) >> 22, v >> 30); \
