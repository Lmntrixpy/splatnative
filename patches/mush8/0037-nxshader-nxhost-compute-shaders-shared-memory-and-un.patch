+            // SplatNative: shared memory (LDS/STS), used by Splatoon 3's compute shaders. Backed by a
+            // threadgroup array of SMEM_WORDS words; addresses wrap inside it.
+            Op::Lds | Op::Sts => {
+                if self.sph.stage != Stage::Compute {
+                    bail!("shared memory outside a compute shader at {:#x}", i.addr);
+                }
+                self.uses_smem = true;
+                let (d, a, off, size) = if i.op == Op::Lds {
+                    let o = op!(InstLds);
+                    (o.dest(), self.r(o.src_a()), o.imm24(), o.ls_size().0)
+                } else {
+                    let o = op!(InstSts);
+                    (o.dest(), self.r(o.src_a()), o.imm24(), o.ls_size().0)
+                };
+                let off = (off << 8) >> 8;
+                let words = match size {
+                    5 => 2,
+                    6 | 7 => 4,
+                    _ => 1,
+                };
+                self.line(format!("{{ uint sa = {a} + {:#x}u; uint si = sa >> 2;", off as u32));
+                if i.op == Op::Lds {
+                    if size < 4 {
+                        let (bits, signed) = match size {
+                            0 => (8, false),
+                            1 => (8, true),
+                            2 => (16, false),
+                            _ => (16, true),
+                        };
+                        if d != RZ_ {
+                            self.line(format!("uint sv0 = bfe(smem[si & SMEM_MASK], (((sa & 3u) * 8u) | ({bits}u << 8)), {signed});"));
+                            self.set(d, "sv0".into());
+                        }
+                    } else {
+                        for k in 0..words {
+                            self.line(format!("uint sv{k} = smem[(si + {k}u) & SMEM_MASK];"));
+                        }
+                        if d != RZ_ {
+                            for k in 0..words {
+                                self.set(d + k, format!("sv{k}"));
+                            }
+                        }
+                    }
+                } else if size < 4 {
+                    let v = self.r(d);
+                    let mask = if size < 2 { "0xffu" } else { "0xffffu" };
+                    self.line(format!("uint sh = (sa & 3u) * 8u; uint sm = {mask} << sh;"));
+                    self.line(format!("smem[si & SMEM_MASK] = (smem[si & SMEM_MASK] & ~sm) | (({v} << sh) & sm);"));
+                } else {
+                    for k in 0..words {
+                        let v = self.r(if d == RZ_ { RZ_ } else { d + k });
+                        self.line(format!("smem[(si + {k}u) & SMEM_MASK] = {v};"));
+                    }
+                }
+                self.line("}");
+            }
             Op::Ldg | Op::Stg => {
 
                 let (d, ra, imm, size, e) = if i.op == Op::Ldg {
@@ -1826,6 +1883,91 @@ static inline uint i2i(uint x, uint sel, uint src, uint dst, bool sat, bool ab,
     return uint(v);
 }
 
+// SplatNative: the attribute decoder for a pointer `p` in address space AS (device or thread).
+#define FETCH_ATTR_DECODE(AS, p) \
