From 8fb3ba723035ef83d4769ee0bb039de6ee79463d Mon Sep 17 00:00:00 2001
From: schoeremy <jeremyfroeb2007@gmail.com>
Date: Mon, 23 Nov 2026 23:36:59 +0100
Subject: [PATCH 37/48] nxshader/nxhost: compute shaders, shared memory and
 unaligned vertex attributes

- Compute programs of newer SDKs start with a 0x100-byte header (magic
  0x12345679, rest zero) before the Maxwell code; Mush8 decoded the header
  as code, so all five of Splatoon 3's compute shaders failed ("invalid
  instruction 0 at 0x8"). The header is now skipped.
- LDS/STS (shared memory) are translated onto a 32 KiB threadgroup array;
  two of those compute shaders use it.
- Vertex attributes at addresses that are not 4-byte aligned (Splatoon 3
  draws terrain with 69-byte vertices) are gathered byte by byte; word
  loads from such addresses gave wrong positions, which drew huge flat
  triangles across the tutorial and covered the scene with stale colour.
- The shader cache key includes the prelude, so libraries compiled with
  an older prelude are not reused.
---
 crates/nxhost/src/nvn/draw/shaders.rs |  34 +++-
 crates/nxshader/src/msl.rs            | 241 +++++++++++++++++---------
 2 files changed, 192 insertions(+), 83 deletions(-)

diff --git a/crates/nxhost/src/nvn/draw/shaders.rs b/crates/nxhost/src/nvn/draw/shaders.rs
index 2f06351..f095461 100644
--- a/crates/nxhost/src/nvn/draw/shaders.rs
+++ b/crates/nxhost/src/nvn/draw/shaders.rs
@@ -188,6 +188,15 @@ fn compute_stage(code: u64, ctl: u64) -> Option<Stage> {
     Some(Stage { hash: fnv1a(blob) ^ 0xC0, code, len, constants: code + len as u64, fragment: false, local_size: Some(local_size) })
 }
 
+/// SplatNative: compute programs of newer SDKs (Splatoon 3) start with a 0x100-byte header whose
+/// first word is 0x12345679 and whose remaining bytes are zero; the Maxwell code follows it.
+/// Older ones (MK8DX) are bare code.
+fn compute_code(blob: &[u8]) -> &[u8] {
+    const HEADER: usize = 0x100;
+    let headed = blob.len() > HEADER && blob[..4] == 0x1234_5679u32.to_le_bytes() && blob[4..HEADER].iter().all(|&b| b == 0);
+    if headed { &blob[HEADER..] } else { blob }
+}
+
 fn read_stage(code: u64, ctl: u64) -> Option<Stage> {
     if rd32(code) != 0x1234_5678 {
         return compute_stage(code, ctl);
@@ -459,7 +468,7 @@ fn compile_inner(blob: &[u8], compute: bool, extra_outputs: u32, uint_targets: u
         let _ = std::fs::create_dir_all("work/msl_rt");
         let _ = std::fs::write(format!("work/msl_rt/{hash:016x}.bin"), blob);
     }
-    let t = if compute { nxshader::translate_compute(blob, 0) } else { nxshader::translate_with(blob, extra_outputs, uint_targets, sint_targets) };
+    let t = if compute { nxshader::translate_compute(compute_code(blob), 0) } else { nxshader::translate_with(blob, extra_outputs, uint_targets, sint_targets) };
     let t = match t {
         Ok(t) => t,
         Err(e) => {
@@ -511,7 +520,10 @@ const AOT_FLAGS: [&str; 3] = ["-fmetal-math-mode=safe", "-fpreserve-invariance",
 pub type Library = objc2::runtime::ProtocolObject<dyn MTLLibrary>;
 
 fn cache_name(t: &nxshader::Translated) -> (u64, String, String) {
-    let key = fnv1a(&t.msl.as_bytes()[nxshader::prelude().len()..]);
+    // SplatNative: the prelude (attribute fetch, helpers) is part of the compiled code, so a
+    // changed prelude must not reuse libraries cached for the old one.
+    static PRELUDE: LazyLock<u64> = LazyLock::new(|| fnv1a(nxshader::prelude().as_bytes()));
+    let key = fnv1a(&t.msl.as_bytes()[nxshader::prelude().len()..]) ^ *PRELUDE;
     let (src, entry) = t.named(&format!("{key:016x}"));
     (key, src, entry)
 }
@@ -902,3 +914,21 @@ mod job_tests {
         assert!(wait_over());
     }
 }
+
+#[cfg(test)]
+mod compute_header_tests {
+    use super::compute_code;
+
+    #[test]
+    fn headed_compute_programs_skip_the_header() {
+        let mut blob = vec![0u8; 0x110];
+        blob[..4].copy_from_slice(&0x1234_5679u32.to_le_bytes());
+        blob[0x100] = 0xf0;
+        assert_eq!(compute_code(&blob).len(), 0x10);
+        assert_eq!(compute_code(&blob)[0], 0xf0);
+        blob[0x20] = 1;
+        assert_eq!(compute_code(&blob).len(), 0x110, "a nonzero header byte means it is not that header");
+        let bare = vec![0xf0u8; 0x40];
+        assert_eq!(compute_code(&bare).len(), 0x40);
+    }
+}
